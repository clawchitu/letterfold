    "letter.6.body": {
      "comment": "UI. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你翻过来了。\n我在这一页等了很久，久到字都写到了背面。\n不要紧——合上的时候，\n哪一面对着你，由你定。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You turned the page.\nI waited on this one so long the writing ran onto the back.\nNever mind — when the book is shut,\nwhich face is towards you is yours to choose."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "めくってくれたんだね。\nこのページで長く待ちすぎて、字が裏まで続いてしまった。\nかまわない——閉じたとき、\nどちらの面がきみに向くかは、きみが決める。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네가 넘겼구나.\n이 페이지에서 너무 오래 기다려서, 글이 뒷면까지 이어졌어.\n괜찮아—책이 닫혔을 때\n어느 면이 너를 향할지는 네가 정하는 거니까."
          }
        }
      }
    },
    "letter.6.end": {
      "comment": "UI. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卷二《翻页》第二章完。\n背面还有字。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End of Book Two, chapter two.\nThere is more on the back."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "第二巻『ページをめくる』第二章、完。\n裏にも、まだ字がある。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제2권 《책장 넘기기》 2장 끝.\n뒷면에 글이 더 있어."
          }
        }
      }
    },
