    "ch.10.line": {
      "comment": "UI. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每合一次书，鹤就飞到对页。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each time the book closes, the crane flies to the other page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本を閉じるたび、鶴は向かいのページへ飛ぶ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "책을 닫을 때마다, 학은 맞은편 페이지로 날아간다."
          }
        }
      }
    },
