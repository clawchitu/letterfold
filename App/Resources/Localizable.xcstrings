    "letter.5.body": {
      "comment": "UI. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我想跟着你翻过去，可是页角粘住了。\n粘住的东西会跟着走——\n那就让石头先替我过河，\n影子跟着它，我跟着影子。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I meant to follow you over, but the corner of the page is stuck.\nWhat is stuck goes where the page goes —\nso let the stone cross the river for me first;\nits shadow follows it, and I follow the shadow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "きみについてめくるつもりだったのに、ページの角が貼りついていた。\n貼りついたものは、ページと一緒に動く——\nなら、先に石に川を渡らせよう。\n影は石について、わたしは影についていく。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "너를 따라 넘어가려 했는데, 페이지 모서리가 붙어 버렸어.\n붙은 것은 페이지와 함께 움직여—\n그러니 돌이 먼저 강을 건너게 할게.\n그림자는 돌을 따르고, 나는 그림자를 따라갈게."
          }
        }
      }
    },
    "letter.5.end": {
      "comment": "UI. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卷二《翻页》第一章完。\n页角还粘着。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End of Book Two, chapter one.\nThe corner is still stuck."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "第二巻『ページをめくる』第一章、完。\nページの角は、まだ貼りついている。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제2권 《책장 넘기기》 1장 끝.\n모서리는 아직 붙어 있어."
          }
        }
      }
    },
