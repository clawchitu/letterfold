    "slip.glue.body": {
      "comment": "UI. Native app only. 物件笺 (fold-proto design-onboarding §2.4–2.5). ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "胶。合上书，它把对面那格的石头粘过来——石头换了页，路也换了。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glue. Close the book and it pulls the stone facing it across — the stone changes page, and so does the road."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "糊。本を閉じると、向かいの枡の石をこちらに貼りつける。石がページを変え、道も変わる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "풀이에요. 책을 닫으면 맞은편 칸의 돌을 이쪽으로 붙여 와요. 돌이 페이지를 옮기면 길도 바뀌어요."
          }
        }
      }
    },
