    "tri.walkFolded": {
      "comment": "UI. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第三页合在右页上时走不了：按「第三页」换回书的折痕再走"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With the third page folded down you can’t walk: switch back to the book’s crease (P) first"
          }
