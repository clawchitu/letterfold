    "hint.portrait.back": {
      "comment": "UI. Native app only.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合上过去，展开走一段，再合上回到下页。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close to cross, open to walk a while, then close again to come back to the bottom page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じて渡り、開いて少し歩き、また閉じて下のページへ戻る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫아서 건너고, 펼쳐서 조금 걷고, 다시 닫아 아래 페이지로 돌아와요."
          }
        }
      }
    },
    "hint.portrait.bridge": {
      "comment": "UI. Native app only.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把上页合下来：上页的纸板会正好盖住缺口。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the book: the card on the top page lands exactly over the gap."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本を閉じると、上のページの厚紙がすき間にぴたりと重なる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "책을 덮으면 위 페이지의 종이판이 틈을 꼭 덮어요."
          }
        }
      }
    },
    "hint.portrait.crease": {
      "comment": "UI. Native app only.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先合上一次，钥匙和墨都印过去；再立起过桥、走到门边，最后合上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close once so the key and the ink carry across; stand the page, cross, walk to the door, then close."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず一度閉じて鍵と墨を写す。立てて橋を渡り、扉まで歩いて、最後に閉じる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 한 번 닫아 열쇠와 먹을 찍어요. 세워서 다리를 건너 문까지 걷고, 마지막에 닫아요."
          }
        }
      }
    },
    "hint.portrait.doorBridge": {
      "comment": "UI. Native app only.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先合上，让钥匙开门；再立起到一半，从纸片桥上走过去。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close so the key opens the door; then stand the page halfway and cross on the tabs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じて鍵で扉を開け、半分立てて紙片の橋を渡る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫아서 열쇠로 문을 열고, 반쯤 세워 종이 다리를 건너요."
          }
        }
      }
    },
    "hint.portrait.facing": {
      "comment": "UI. Native app only.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合上，走到上页的路上；石头挡住了，就展开继续走。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close, and step onto the top page’s path; when a stone blocks you, open and walk on."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じて上のページの道へ。石にふさがれたら、開いて先へ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫고 위 페이지의 길로 건너가요. 돌이 막으면 펼쳐서 계속 걸어요."
          }
        }
      }
    },
    "hint.portrait.ink": {
      "comment": "UI. Native app only.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合上一次，墨会印到上页的缺口上；展开后它还在。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close once: the ink prints onto the gap on the top page, and stays when you open."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度閉じると、墨が上のページのすき間に写る。開いても残る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 닫으면 먹이 위 페이지 틈에 찍혀요. 펼쳐도 남아 있어요."
          }
        }
      }
    },
    "hint.portrait.inkBridge": {
      "comment": "UI. Native app only.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只合上一次，让墨印到上页；再立起到一半过桥。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close only once so the ink prints onto the top page; then stand it halfway and cross."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度だけ閉じて墨を上のページに写し、半分立てて渡る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번만 닫아 먹을 위 페이지에 찍고, 반쯤 세워 건너요."
          }
        }
      }
    },
    "hint.portrait.key": {
      "comment": "UI. Native app only.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钥匙和门隔着折痕上下对称。合上，它们就碰到了。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Key and door mirror each other across the fold. Close, and they meet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵と扉は折り目をはさんで向かい合う。閉じれば、ふれあう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열쇠와 문은 접는 선을 사이에 두고 마주 보고 있어요. 닫으면 서로 닿아요."
          }
        }
      }
    },
    "hint.portrait.shadow": {
      "comment": "UI. Native app only.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把书慢慢合到一半多一点，上页石头的影子会落在缺口上。影子能走。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the book slowly, a little past halfway: the shadow of the top page's stone falls on the gap. Shadows can be walked on."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本をゆっくり半分より少し多く閉じると、上のページの石の影がすき間に落ちる。影は歩ける。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "책을 반보다 조금 더 천천히 닫으면 위 페이지 돌의 그림자가 틈에 떨어져요. 그림자 위는 걸을 수 있어요."
          }
        }
      }
    },
    "hint.portrait.stand": {
      "comment": "UI. Native app only.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把上页立起到一半：折痕上的两片纸片会连成一座桥。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand the top page halfway: the two tabs on the crease join into a bridge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上のページを半分だけ立てると、折り目の紙片がつながって橋になる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위 페이지를 반쯤 세우면 접는 선의 종이 조각이 이어져 다리가 돼요."
          }
        }
      }
    },
    "hint.portrait.standClose": {
      "comment": "UI. Native app only.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先立起来过桥，在上页走到头，再合上：终点就在脚下。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand the page and cross, walk to the end of the top page, then close: the goal is right under you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "立てて橋を渡り、上のページを端まで歩いてから閉じる。ゴールは足もと。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세워서 다리를 건너 위 페이지 끝까지 걷고 닫아요. 도착점이 발밑이에요."
          }
        }
      }
    },
    "hint.portrait.twoBridges": {
      "comment": "UI. Native app only.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立起到一半，两座桥都在：走过一座，沿着立起的上页走，再从另一座回来。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand the page halfway: both bridges are up. Cross one, walk along the standing page, come back over the other."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "半分立てると橋が二つ。一つを渡り、立ったページを歩いて、もう一つで戻る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반쯤 세우면 다리가 둘이에요. 하나를 건너 선 페이지를 걷고, 다른 다리로 돌아와요."
          }
        }
      }
    },
