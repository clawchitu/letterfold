    "slip.turn.body": {
      "comment": "UI. Native app only. 物件笺 (fold-proto design-onboarding §2.4–2.5). ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这封信有第三页。合上书，翻个面再打开：下页没变，对面换成了第三页。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This letter has a third page. Close the book, turn it over and open it: the bottom page is the same, but it now faces the third page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この手紙には三枚目の頁がある。本を閉じ、裏返して開くと、下の頁はそのまま、向かいが三枚目の頁になる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 편지에는 세 번째 페이지가 있어요. 책을 닫고 뒤집어 펼치면, 아래 페이지는 그대로이고 맞은편이 세 번째 페이지로 바뀌어요."
          }
        }
      }
    },
