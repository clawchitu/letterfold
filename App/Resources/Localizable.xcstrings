    "letter.1.body": {
      "comment": "UI. Native app only.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "河很宽，纸很薄。\n我把想说的话折了四次，\n等你合上它的那天。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The river is wide; the paper, thin.\nI folded what I meant to say\nfour times,\nfor the day you close it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "川は広く、紙は薄い。\n言いたいことを四度折って、\nきみが閉じる日を待つ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강은 넓고 종이는 얇다.\n하고 싶은 말을 네 번 접어,\n네가 덮는 날을 기다린다."
          }
        }
      }
    },
    "letter.1.sign": {
      "comment": "UI. Native app only.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "——左岸"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "— the Left Bank"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "——左岸より"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "— 왼쪽 강가에서"
          }
        }
      }
    },
    "letter.10.body": {
      "comment": "UI. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "石头太重了，我折了只鹤。\n每合一次书，它就飞到你那页同样的位置——\n同样的位置，在你那页是反过来的。\n站在它上面。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The stones were too heavy, so I folded a crane.\nEach time the book closes it flies to the same square on your page —\nthe same square, which on your page is the other way round.\nStand on it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "石は重すぎたから、鶴を折った。\n本を閉じるたび、きみのページの同じ場所へ飛ぶ——\n同じ場所は、きみのページでは裏返し。\nその上に立って。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "돌이 너무 무거워서, 학을 접었어.\n책을 닫을 때마다 네 페이지의 같은 자리로 날아가—\n같은 자리는, 네 페이지에서는 거꾸로야.\n그 위에 올라서."
          }
        }
      }
    },
    "letter.10.end": {
      "comment": "UI. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卷三《倾》第二章完。\n下一章，什么都没发生的时候。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End of Book Three, chapter two.\nNext, when nothing happens."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "第三巻『傾く』第二章、完。\n次の章、何も起きなかったとき。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제3권 《기울기》 2장 끝.\n다음 장, 아무 일도 없었을 때."
          }
        }
      }
    },
