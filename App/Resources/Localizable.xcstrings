    "letter.4.body": {
      "comment": "UI. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合上的那一下，我们站在同一格里。\n打开，河还在。\n没关系——这本书还有下一页，\n我先翻过去等你。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For the moment the book was shut, we stood in the same square.\nOpen it, and the river is still there.\nNever mind: this book has another page.\nI will turn it first, and wait for you there."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じたあの一瞬、わたしたちは同じマスに立っていた。\n開けば、川はまだそこにある。\nかまわない——この本には次のページがある。\n先にめくって、そこで待っている。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "책이 닫힌 그 순간, 우리는 같은 칸에 서 있었어.\n펼치면, 강은 아직 거기 있어.\n괜찮아—이 책에는 다음 페이지가 있으니까.\n내가 먼저 넘겨서, 거기서 기다릴게."
          }
        }
      }
    },
    "letter.4.end": {
      "comment": "UI. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卷一《两岸》完。\n下一页，还在折。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End of Book One, The Two Banks.\nThe next page is still being folded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "第一巻『両岸』、完。\n次のページは、まだ折っている途中。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제1권 《양안》 끝.\n다음 페이지는 아직 접는 중."
          }
        }
      }
    },
    "letter.4.sign": {
