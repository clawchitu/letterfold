    "letter.7.body": {
      "comment": "UI. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "墨还没干。\n我每合一次书，字就往你那边洇一圈——\n洇到页边，洇到背面。\n别等它干。合上来。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ink is not dry.\nEach time I close the book the words bleed a ring towards you —\nto the margin, through to the back.\nDon’t wait for it to dry. Close the book."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "墨はまだ乾いていない。\n本を閉じるたび、字はきみのほうへひとまわり滲む——\nページの端まで、裏まで。\n乾くのを待たないで。閉じて。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먹이 아직 마르지 않았어.\n책을 닫을 때마다 글이 네 쪽으로 한 겹 번져—\n여백까지, 뒷면까지.\n마르기를 기다리지 마. 닫아 줘."
          }
        }
      }
    },
    "letter.7.end": {
      "comment": "UI. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卷二《翻页》第三章完。\n下一章，灯换了岸。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End of Book Two, chapter three.\nNext, the lamp changes banks."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "第二巻『ページをめくる』第三章、完。\n次の章で、灯りが岸を変える。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제2권 《책장 넘기기》 3장 끝.\n다음 장에서는 등불이 강가를 바꿔."
          }
        }
      }
    },
