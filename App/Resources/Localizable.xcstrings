    "slip.crane.pic": {
      "comment": "UI. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图：站上鹤，合上，你在对页；落点有石头，它留在原地。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picture: stand on the crane, close, and you are on the other page; with a stone on its landing it stays."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "図：鶴に乗って閉じれば、向かいのページ。降り場に石があれば、その場に残る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림: 학 위에서 닫으면 맞은편 페이지. 내려앉을 자리에 돌이 있으면 그 자리에 남아요."
          }
        }
      }
    },
