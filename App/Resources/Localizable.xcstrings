    "fellOff": {
      "comment": "UI. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "书合上时第三页还摊着，它甩出左页外沿扣在桌上——你也跟着掉下去了。回到起点，信重新摊平"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The book closed with the third page still open: it swung out past the left page onto the table, with you on it. Back to the start, the letter laid flat again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "三枚目を開いたまま本を閉じた。三枚目は左ページの外へ振り出されて机に伏せ、あなたも一緒に落ちた。最初から、手紙を広げなおす"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "셋째 페이지를 편 채로 책을 닫았어요. 셋째 페이지가 왼쪽 페이지 밖으로 넘어가 책상에 엎어지고, 나도 함께 떨어졌어요. 처음부터, 편지를 다시 펼쳐요"
          }
        }
      }
    },
