    "allDone": {
      "comment": "UI. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部完成。等 Duo 到了，用真的折痕再玩一次。"
          }
