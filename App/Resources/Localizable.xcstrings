    "tri.aside": {
      "comment": "UI. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第三页立着的时候，你在左页上哪儿也去不了"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While the third page is up you can’t go anywhere on the left page"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "三枚目が起きているあいだ、左ページではどこへも行けない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "셋째 페이지가 들려 있는 동안 왼쪽 페이지에서는 어디로도 갈 수 없어요"
          }
        }
      }
    },
    "tri.blocked": {
      "comment": "UI. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第三页折不下去：你站在它上面，正下方右页是石头。先走开"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The third page won’t fold down: you’re standing on it right over a stone on the right page. Step off first"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "三枚目は折れない：その上に立っていて、真下の右ページが石。先にどいて"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "셋째 페이지가 접히지 않아요: 그 위에 서 있고, 바로 아래 오른쪽 페이지는 돌이에요. 먼저 비켜요"
          }
        }
      }
    },
    "tri.bookFirst": {
      "comment": "UI. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先把书摊平，才能折第三页——一次只动一道折痕"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lay the book flat first — one crease moves at a time"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に本を平らに——折り目は一度にひとつ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 책을 평평하게 펴요—접는 선은 한 번에 하나만"
          }
        }
      }
    },
    "tri.covered": {
      "comment": "UI. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第三页折不下去：它的纸会盖在你身上。站到它的洞下面，或者离开右页"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The third page won’t fold down: its paper would lie on you. Stand under one of its holes, or leave the right page"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "三枚目は折れない：その紙があなたに被さる。穴の下に立つか、右ページから離れて"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "셋째 페이지가 접히지 않아요: 그 종이가 나를 덮게 돼요. 구멍 아래에 서거나, 오른쪽 페이지에서 비켜요"
          }
        }
      }
    },
    "tri.flapFirst": {
      "comment": "UI. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先把第三页放平，或者折到底，才能折书"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lay the third page flat, or fold it all the way, before you fold the book"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "三枚目を平らにするか、最後まで折ってから、本を折る"
          }
