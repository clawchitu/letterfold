    "letter.1.body": {
      "comment": "UI. Native app only.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "河很宽，纸很薄。\n我把想说的话折了四次，\n等你合上它的那天。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The river is wide; the paper, thin.\nI folded what I meant to say\nfour times,\nfor the day you close it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "川は広く、紙は薄い。\n言いたいことを四度折って、\nきみが閉じる日を待つ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강은 넓고 종이는 얇다.\n하고 싶은 말을 네 번 접어,\n네가 덮는 날을 기다린다."
          }
        }
      }
    },
    "letter.1.sign": {
      "comment": "UI. Native app only.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "——左岸"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "— the Left Bank"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "——左岸より"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "— 왼쪽 강가에서"
          }
        }
      }
    },
    "letter.2.body": {
      "comment": "UI. Native app only.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "河没有变窄，\n纸却先站了起来，\n替我走到岸边。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The river is no narrower,\nbut the paper stood up first\nand walked to the bank for me."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "川は狭くならない。\nけれど紙が先に立ちあがり、\nわたしの代わりに岸まで歩いた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강은 좁아지지 않았다.\n그런데 종이가 먼저 일어서서\n나 대신 강가까지 걸어갔다."
          }
        }
      }
    },
    "letter.2.end": {
      "comment": "UI. Native app only.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第二章完。\n下一封信，还在路上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End of Chapter Two.\nThe next letter is still on its way."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "第二章 了。\n次の手紙は、まだ途中。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제2장 끝.\n다음 편지는 아직 오는 길."
          }
        }
      }
    },
    "letter.2.sign": {
      "comment": "UI. Native app only.",
      "extractionState": "manual",
