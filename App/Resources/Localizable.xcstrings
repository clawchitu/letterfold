    "letter.8.body": {
      "comment": "UI. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我把灯挪到你那岸了。\n这样你每举起一页，落在上面的都是我这边的影子。\n两盏灯一起亮的时候，影子会在同一页上遇见。\n信翻完了。灯留给你。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have moved the lamp to your bank.\nNow every page you lift carries a shadow from my side.\nWhen both lamps are lit, the shadows meet on the same page.\nThe letter is turned to its last page. Keep the lamp."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "灯りをきみの岸へ移した。\nこれからは、きみがページを持ち上げるたび、そこに落ちるのはこちらの影。\n両方の灯りがともるとき、影は同じページで出会う。\n手紙は最後のページまでめくった。灯りは、きみに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "등불을 네 강가로 옮겼어.\n이제 네가 페이지를 들어 올릴 때마다, 거기 떨어지는 건 내 쪽의 그림자야.\n두 등불이 함께 켜지면, 그림자는 같은 페이지에서 만나.\n편지는 마지막 페이지까지 넘겼어. 등불은 네게 둘게."
          }
        }
      }
    },
    "letter.8.end": {
      "comment": "UI. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卷二《翻页》完。\n卷三，把书立起来。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End of Book Two, Turning the Page.\nBook Three: stand the book up."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "第二巻『ページをめくる』、完。\n第三巻は、本を立てる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제2권 《책장 넘기기》 끝.\n제3권, 책을 세워."
          }
        }
      }
    },
