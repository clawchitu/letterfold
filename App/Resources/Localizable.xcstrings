    "ch.11.line": {
      "comment": "UI. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立起来，又放下。什么都没发生的时候，其实什么都发生了。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand it up, lay it down. When nothing happened, everything did."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "立てて、また寝かせる。何も起きなかったとき、ほんとうはすべてが起きていた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세웠다가, 다시 눕힌다. 아무 일도 없었을 때, 사실은 모든 일이 있었다."
          }
        }
      }
    },
