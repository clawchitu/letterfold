    "tri.flapView": {
      "comment": "UI. From fold-proto i18n.js. Placeholders: {a}",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第三页在它自己的折痕上，{a}°；右页平放，左页在一边够不着"
          }
