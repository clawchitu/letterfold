    "letter.11.body": {
      "comment": "UI. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立起来，又放下。\n你以为什么都没发生——\n石头已经在河里了，影子已经换了列。\n来回几次，我数着。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stood it up, laid it down.\nYou think nothing happened —\nthe stone is in the river already, the shadow has changed its column.\nTo and fro, a few times. I counted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "立てて、また寝かせた。\n何も起きなかったと思うだろう——\n石はもう川の中、影はもう列を変えた。\n何度か往き来した。わたしは数えていた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세웠다가, 다시 눕혔어.\n아무 일도 없었다고 생각하겠지—\n돌은 벌써 강에 있고, 그림자는 벌써 열을 바꿨어.\n몇 번을 오갔는지, 나는 세고 있었어."
          }
        }
      }
    },
    "letter.11.end": {
      "comment": "UI. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卷三《倾》第三章完。\n下一章，信要折两次。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End of Book Three, chapter three.\nNext, a letter folded twice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "第三巻『傾く』第三章、完。\n次の章、手紙は二度折る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제3권 《기울기》 3장 끝.\n다음 장, 편지를 두 번 접어."
          }
        }
      }
    },
    "letter.11.sign": {
