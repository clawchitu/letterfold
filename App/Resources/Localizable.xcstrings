    "letter.2.title": {
      "comment": "UI. Native app only.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右岸来信"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Letter from the Right Bank"
          }
        },
        "ja": {
          "stringUnit": {
