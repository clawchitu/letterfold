          }
        }
      }
    },
    "letter.3.body": {
      "comment": "UI. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灯在你那岸。\n你的石头把影子递过河来，\n我踩着它，又近了一点。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lamp is on your bank.\nYour stones passed their shadows across the river,\nand I walked on them,\na little closer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "灯はきみの岸にある。\nきみの石が影を川向こうへ差し出し、\nわたしはそれを踏んで、少し近づいた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "등불은 네 쪽 강가에 있다.\n네 돌들이 그림자를 강 건너로 건네주어,\n나는 그것을 밟고 조금 더 가까워졌다."
          }
        }
      }
    },
    "letter.3.end": {
      "comment": "UI. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第三章完。\n下一封信，还在路上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End of Chapter Three.\nThe next letter is still on its way."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "第三章 了。\n次の手紙は、まだ途中。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제3장 끝.\n다음 편지는 아직 오는 길."
          }
        }
      }
    },
