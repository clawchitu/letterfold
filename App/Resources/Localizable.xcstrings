          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Letter from the Left Bank"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左岸からの手紙"
          }
        },
        "ko": {
