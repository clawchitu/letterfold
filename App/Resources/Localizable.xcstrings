    "letter.9.body": {
      "comment": "UI. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我过不去，就把东西送过去。\n书立起来的时候，什么都往低处滚——\n低处是折痕，折痕是你。\n别接，让它滚到底。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I cannot cross, so I send things over.\nWhen the book stands, everything rolls to the low place —\nthe low place is the crease, and the crease is you.\nDon’t catch it. Let it roll all the way."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "渡れないなら、ものを送る。\n本を立てると、なにもかも低いほうへ転がる——\n低いほうは折り目で、折り目はきみ。\n受け止めないで。最後まで転がして。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건널 수 없으니, 물건을 보낼게.\n책을 세우면 모든 것이 낮은 곳으로 굴러가—\n낮은 곳은 접는 선, 접는 선은 너야.\n받지 마. 끝까지 구르게 둬."
          }
        }
      }
    },
    "letter.9.end": {
      "comment": "UI. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卷三《倾》第一章完。\n下一章，石头太重了。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End of Book Three, chapter one.\nNext, the stones are too heavy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "第三巻『傾く』第一章、完。\n次の章、石は重すぎる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제3권 《기울기》 1장 끝.\n다음 장, 돌이 너무 무거워."
          }
        }
      }
    },
