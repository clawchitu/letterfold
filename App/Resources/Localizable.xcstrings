    "layerRule": {
      "comment": "UI. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合着走：两页都是纸的地方，你留在原来那一页；只有一页是纸的地方，才会换到那一页去"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walking closed: where both pages are paper you stay on the page you are on; you change page only where exactly one of them is paper"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じたまま歩くとき：両方のページが紙なら、いまのページにとどまる。片方だけが紙のところで、そのページへ移る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫은 채 걸을 때: 두 페이지가 모두 종이인 곳에서는 지금 페이지에 머물러요. 한쪽만 종이인 곳에서만 그 페이지로 옮겨 가요"
          }
        }
      }
    },
    "left": {
      "comment": "UI. From fold-proto i18n.js.",
