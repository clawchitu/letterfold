        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lamp has moved to the left."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "灯が左へ移った。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "등불이 왼쪽으로 옮겨 갔어요."
          }
        }
      }
    },
    "leftLamp.name": {
      "comment": "Level \"leftLamp\": title. From fold-proto i18n.js. ja/ko: TODO-native-check.",
