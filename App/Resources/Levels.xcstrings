    "late.name": {
      "comment": "Level \"late\": title. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "迟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Late"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遅れ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "늦게"
          }
        }
      }
    },
    "leftLamp.hint": {
      "comment": "Level \"leftLamp\": hint. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "斜起到 60°：左页石头的影子落在右页你旁边的缺口上。走上去，再合到 45°——影子往外滑，把你带到她那格。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lean to 60°: the left page’s stone shades the gap beside you on the right page. Step on, then close to 45° — the shadow slides outward and carries you to her square."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "60° まで傾ける：左頁の石の影が右頁の隣の隙間に落ちる。乗って 45° まで閉じる——影が外へ滑り、彼女の枡まで運ぶ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "60°까지 기울여요: 왼쪽 면 돌의 그림자가 오른쪽 면 옆 틈에 떨어져요. 올라서서 45°까지 닫아요. 그림자가 바깥으로 미끄러져 그녀의 칸까지 데려다줘요."
          }
        }
      }
    },
    "leftLamp.hint1": {
      "comment": "Level \"leftLamp\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "影子落在你举起来的那页上，越合越往外。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shadows fall on the page you lift, and slide outward as you close."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "影は持ち上げた頁に落ち、閉じるほど外へ滑る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림자는 들어 올린 면에 떨어지고, 닫을수록 바깥으로 미끄러져요."
          }
        }
      }
    },
