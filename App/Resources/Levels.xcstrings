    "print.hint": {
      "comment": "Level \"print\": hint. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "墨印到右页之后，右页的那片墨也会洇。合一次不够，合两次：第二圈洇到右下角。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once the ink has printed onto the right page, that print bleeds as well. One close is not enough; close twice and the second ring reaches the bottom-right corner."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右頁に写った墨も滲む。一度では足りない。二度閉じると、二周目が右下の角に届く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 면에 찍힌 먹도 번져요. 한 번으로는 모자라요. 두 번 닫으면 두 번째 겹이 오른쪽 아래 모서리에 닿아요."
          }
        }
      }
    },
    "print.hint1": {
      "comment": "Level \"print\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对面那片墨，也会长。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The blot on the far page grows too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "向こうの墨も育つ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건너편 먹도 자라요."
          }
        }
      }
    },
    "print.line": {
