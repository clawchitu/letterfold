    },
    "wet.line": {
      "comment": "Level \"wet\": one-line teaser. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这滴墨还没干。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This blot has not dried."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この墨はまだ乾いていない。"
