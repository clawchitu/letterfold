        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The letter is on your page. The road is not."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手紙は同じページに。道は違う。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편지는 같은 페이지에, 길은 아니다."
          }
        }
      }
    },
    "facing.name": {
