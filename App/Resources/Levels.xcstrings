    "doorBridge.hint": {
      "comment": "Level \"doorBridge\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "走到钥匙和纸片那格，合上：门开了。半开，过桥、穿门，沿右页走到右下角，再合上——这一叠下面是石头，你站在它背上。合着往右一格，纸把你换到左页，信在旁边。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk to the key beside the tab and close: the door opens. Half-open, cross, go through the door and down the right page to its corner, then close again — this stack sits on a stone; you stand on its back. Closed, one step right hands you to the left page, beside the letter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "（TODO ja）鍵の枡まで歩いて閉じる。扉が開く。半分開いて渡り、扉を抜けて右ページの角へ、また閉じる。石の背の上に立つ。閉じたまま右へ一歩で左ページ、手紙はとなり。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "(TODO ko) 열쇠 칸까지 걸어가 닫아요. 문이 열려요. 반쯤 열어 건너고 문을 지나 오른쪽 페이지 모서리로, 다시 닫아요. 돌의 등 위에 서 있어요. 닫은 채 오른쪽 한 칸이면 왼쪽 페이지, 편지는 옆에."
          }
        }
      }
    },
    "doorBridge.hint1": {
      "comment": "Level \"doorBridge\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先合，还是先过桥？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close first, or cross first?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に閉じるか、先に渡るか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 닫을까, 먼저 건널까?"
          }
        }
      }
    },
    "doorBridge.line": {
      "comment": "Level \"doorBridge\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
