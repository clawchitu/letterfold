    "twice.hint": {
      "comment": "Level \"twice\": hint. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "斜起（它滚一格），再放平（再滚一格）：石头掉进缺口，桥就有了。合上再打开，也是这两次。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lean (it rolls one), flatten (it rolls one more): the stone drops into the gap and the bridge is there. Close and open again would have been the same two passes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "傾けて（一マス転がる）、寝かせる（もう一マス）：石がすき間に落ちて、橋ができる。閉じて開いても、同じ二度。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기울이고(한 칸 굴러요), 눕혀요(한 칸 더): 돌이 틈에 빠져 다리가 생겨요. 닫았다 열어도, 같은 두 번이에요."
          }
        }
      }
    },
    "twice.hint1": {
      "comment": "Level \"twice\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来回一次是两次过立；放平那一下也算。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A lean that comes back is two passes; flattening counts too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "傾けて戻すのは、二度立つこと。寝かせるほうも数える。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기울였다 눕히는 건 두 번 서는 것. 눕히는 쪽도 세요."
          }
        }
      }
    },
    "twice.line": {
