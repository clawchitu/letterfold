    "wet.hint": {
      "comment": "Level \"wet\": hint. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合上书：墨往四周洇一格，起点旁边的缺口变成了墨。打开，走过去。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the book: the ink bleeds one square outward, and the gap beside the start becomes ink. Open and walk across."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本を閉じる：墨が一枡外へ滲み、スタート横の隙間が墨になる。開いて歩いて渡る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "책을 닫아요: 먹이 한 칸 밖으로 번지고, 출발점 옆 빈칸이 먹이 돼요. 열고 건너가요."
          }
        }
      }
    },
    "wet.hint1": {
      "comment": "Level \"wet\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合一次，看它长。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close once and watch it grow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度閉じて、広がるのを見て。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 닫고, 자라는 걸 봐요."
          }
