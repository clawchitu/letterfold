          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What it prints is wet too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写ったほうも、濡れている。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "찍힌 쪽도, 젖어 있다."
          }
        }
      }
    },
    "print.name": {
      "comment": "Level \"print\": title. From fold-proto i18n.js. ja/ko: TODO-native-check.",
