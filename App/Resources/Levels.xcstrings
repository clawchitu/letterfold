          }
        }
      }
    },
    "shadow.hint": {
      "comment": "Level \"shadow\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把书慢慢合到一半多一点，右页石头的影子会落在缺口上。影子能走。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the book slowly, a little past halfway: the stone’s shadow falls across the gap. Shadows can be walked on."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本をゆっくり、半分より少しだけ閉じると、右ページの石の影がすき間に落ちる。影は歩ける。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "책을 천천히 반보다 조금 더 닫으면 오른쪽 돌의 그림자가 틈에 드리워요. 그림자 위로는 걸을 수 있어요."
          }
        }
      }
    },
    "shadow.line": {
      "comment": "Level \"shadow\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灯在纸的后面。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is a lamp behind the page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "紙のうしろに、灯がある。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종이 뒤에 등불이 있다."
          }
        }
      }
    },
    "shadow.name": {
      "comment": "Level \"shadow\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "影"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shade"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "影"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림자"
          }
        }
      }
    },
    "shadowFirst.hint": {
      "comment": "Level \"shadowFirst\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这块石头的影子是你唯一的桥——可是合上时胶会把它粘走。先斜起到 40° 左右，走过影子，站到对面那格纸上，再合上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This stone’s shadow is your only bridge, and closing lets the glue take the stone. Lean to about 40° first, cross the shadow onto the paper beyond, then close."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この石の影がただ一つの橋。けれど閉じれば糊が石を持っていく。まず40°くらいまで傾け、影を渡って向こうの紙に立ち、それから閉じる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 돌의 그림자가 유일한 다리인데, 닫으면 풀이 돌을 가져가요. 먼저 40° 정도로 기울여 그림자를 건너 건너편 종이에 서고, 그다음 닫아요."
          }
        }
      }
    },
    "shadowFirst.hint1": {
      "comment": "Level \"shadowFirst\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "别急着合上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not close yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ閉じないで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 닫지 마세요."
          }
        }
      }
    },
    "shadowFirst.line": {
      "comment": "Level \"shadowFirst\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "影子只借一次。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shadow is lent once."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "影は一度しか借りられない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림자는 한 번만 빌릴 수 있다."
          }
        }
      }
    },
    "shadowFirst.name": {
      "comment": "Level \"shadowFirst\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "影先"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shadow First"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "影が先"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림자 먼저"
          }
        }
      }
    },
    "soak.hint": {
      "comment": "Level \"soak\": hint. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站上右页的鹤合书，你到了左页 (1,2)。左页那只鹤 (3,4) 对着缺口——可是缺口旁边是湿墨：合的那一拍墨先洇进落点，鹤染了墨，飞不动了，它自己成了一滴墨。斜到 30° 踩 (2,1) 的影子到 (3,1)，再合一次：那滴墨往四周洇，(4,4) 成了纸。斜到 70° 踩 (4,1) 的影子，沿第 4 列下到她。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close standing on the right page’s crane: you are on the left page at (1,2). The left crane at (3,4) faces a gap — but wet ink lies beside that gap: at the press the ink bleeds into the landing first, the crane is soaked and will not fly; it is a blot now. Lean to 30°, cross on the shadow at (2,1) to (3,1), and close again: the blot spreads, and (4,4) is paper. Lean to 70°, take the shadow at (4,1) and walk down column 4 to her."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右頁の鶴の上で閉じる：左頁の (1,2) に着く。左頁の鶴 (3,4) は隙間に向いている——が、隙間の隣は湿った墨：閉じた拍子に墨が先に降り場へ滲み、鶴は染みて飛べない。鶴は一滴の墨になる。30° に傾け (2,1) の影で (3,1) へ、もう一度閉じる：その墨が広がり (4,4) が紙になる。70° に傾け (4,1) の影から 4 列目を下って彼女へ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 면 학 위에서 닫아요: 왼쪽 면 (1,2)에 도착해요. 왼쪽 학 (3,4)은 틈을 보고 있지만 틈 옆엔 젖은 먹: 닫히는 순간 먹이 먼저 내려앉을 자리로 번지고, 학은 물들어 못 날아요. 학은 먹 한 방울이 돼요. 30°로 기울여 (2,1) 그림자로 (3,1)에 가서 다시 닫아요: 그 먹이 번져 (4,4)가 종이가 돼요. 70°로 기울여 (4,1) 그림자를 밟고 4열을 따라 내려가 그녀에게."
          }
        }
      }
    },
    "soak.hint1": {
      "comment": "Level \"soak\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "飞不动的鹤是一滴墨，第二次合它会洇。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A crane that cannot fly is a blot: the next close spreads it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "飛べない鶴は墨。次に閉じれば滲む。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "못 나는 학은 먹 한 방울. 다음에 닫으면 번져요."
          }
        }
      }
    },
    "soak.line": {
      "comment": "Level \"soak\": one-line teaser. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "墨比鹤快。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ink is faster than the crane."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "墨は鶴より速い。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먹이 학보다 빨라요."
          }
        }
      }
    },
    "soak.name": {
      "comment": "Level \"soak\": title. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "染"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soak"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "染みる"
