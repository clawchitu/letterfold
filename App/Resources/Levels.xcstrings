      }
    },
    "darkInk.hint": {
      "comment": "Level \"darkInk\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先走到右页的墨上合书：墨印到左页，胶把石头粘到右页。合着走到左页的墨印，打开到 55°，沿第 4 列走到顶上的影子，打开到 40°，影子带你到第 3 列，走到另一处墨印。在墨印上合书，合着走到右页顶格，打开，往下一格，再合——你站在左页石头的背上，从那里走到她的那一叠。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk onto the right page’s ink and close: it prints onto the left page, the glue pulls the stone across. Closed, walk to the printed ink, open to 55°, up column 4 to the shadow at the top, open to 40°: it carries you to column 3 and the other ink print. Close on the ink, walk the stack to the top of the right page, open, step down one, close again: you stand on a left-page stone’s back. From there, walk to her stack."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右ページの墨に乗って閉じる：墨が左ページに写り、糊が石を右ページへ引き寄せる。閉じたまま写った墨へ歩き、55°まで開いて、4列目を上がっていちばん上の影へ。40°まで開く：影があなたを3列目へ、もう一つの墨の跡へ運ぶ。墨の上で閉じ、重なりを右ページのいちばん上まで歩き、開いて、一マス下へ、また閉じる：あなたは左ページの石の背に立っている。そこから、彼女の重なりへ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 페이지의 먹에 올라서서 닫아요: 먹이 왼쪽 페이지에 찍히고, 풀이 돌을 오른쪽 페이지로 끌어가요. 닫은 채 찍힌 먹으로 걸어가, 55°까지 펼치고, 4열을 따라 맨 위 그림자로 올라가요. 40°까지 펼쳐요: 그림자가 나를 3열로, 또 하나의 먹 자국으로 데려가요. 먹 위에서 닫고, 겹을 따라 오른쪽 페이지 맨 위까지 걸어가, 펼치고, 한 칸 아래로, 다시 닫아요: 나는 왼쪽 페이지 돌의 등 위에 서 있어요. 거기서, 그녀의 겹으로."
          }
        }
      }
    },
    "darkInk.hint1": {
      "comment": "Level \"darkInk\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三次合上，两处墨。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three closes, two inks."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "三度閉じて、墨は二つ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세 번 닫고, 먹은 둘."
          }
        }
      }
    },
    "darkInk.line": {
      "comment": "Level \"darkInk\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "……墨干了再合。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "…close when the ink is dry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "……墨が乾いてから、閉じて。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "……먹이 마르면 닫아."
          }
        }
      }
    },
    "darkInk.name": {
      "comment": "Level \"darkInk\": title. From fold-proto i18n.js.",
