            "state": "translated",
            "value": "The stone is not glued down."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "石は、貼りついていない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "돌이 붙어 있지 않다."
          }
        }
      }
    },
    "roll.name": {
      "comment": "Level \"roll\": title. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
