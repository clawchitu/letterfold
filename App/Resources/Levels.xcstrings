    "hold.hint": {
      "comment": "Level \"hold\": hint. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站到 (6,1)，就在上面那颗松石前面：斜起再放平，下面那颗滚了两格到折痕边，上面那颗被你挡着没动。就地合上，叠合走法通到她。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand at (6,1), right in front of the upper loose stone: lean and flatten, and the lower stone rolls two squares to the crease while the upper one waits behind you. Close where you stand; the stacks lead to her."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "(6,1) に立つ——上の石のすぐ前。傾けて戻すと、下の石は折り目まで二枡転がり、上の石はきみに止められて動かない。その場で閉じれば束が彼女へ続く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "(6,1)에 서요, 위쪽 돌 바로 앞에: 기울였다 펴면 아래 돌은 접힌 금까지 두 칸 구르고, 위 돌은 네가 막아서 그대로예요. 그 자리에서 닫으면 묶음이 그녀에게 이어져요."
          }
        }
      }
    },
    "hold.hint1": {
      "comment": "Level \"hold\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纸人站在石头前面，石头就不滚。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A paper figure standing in front of a stone holds it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "紙人が石の前に立てば、石は転がらない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종이 사람이 돌 앞에 서면 돌은 구르지 않아요."
          }
        }
      }
    },
    "hold.line": {
      "comment": "Level \"hold\": one-line teaser. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "别让上面那颗下来。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don’t let the upper one down."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上の石を下ろすな。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위의 돌을 내려오게 하지 마요."
          }
        }
      }
    },
    "hold.name": {
      "comment": "Level \"hold\": title. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
