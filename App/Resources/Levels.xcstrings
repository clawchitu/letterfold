        }
      }
    },
    "hold.name": {
      "comment": "Level \"hold\": title. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
