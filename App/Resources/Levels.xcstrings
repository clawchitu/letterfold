        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One ring is enough."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひとまわりで足りる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 겹이면 돼요."
          }
