        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One Close"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度だけ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번만"
          }
        }
      }
    },
    "order.hint": {
      "comment": "Level \"order\": hint. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到 (1,2) 合上：上面的胶粘走对面的方石头，松石的路空出来了。打开（它滚到第 7 列），再合（去的路上它滚到第 6 列，正好对着那块「死」胶，被粘住）。叠合走法上到右页顶角，开书，沿右边走到她。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close at (1,2): the upper glue takes the square stone opposite, and the loose stone’s lane is clear. Open (it rolls to column 7), close again (on the way it rolls to column 6, right in front of the “dead” glue, which takes it). Walk the stacks up to the right page’s top corner, open, and go down the right edge to her."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "(1,2) で閉じる：上の糊が向かいの四角い石を取り、転がる石の道があく。開いて（7 列目へ転がる）、また閉じる（途中で 6 列目へ転がり、「死んだ」糊の正面に来て貼りつく）。束で右頁の上角へ上がり、開いて右端を彼女へ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "(1,2)에서 닫아요: 위쪽 풀이 맞은편 네모난 돌을 붙여 가고, 구르는 돌의 길이 비어요. 열고(7열로 굴러요), 다시 닫아요(가는 길에 6열로 굴러 \"죽은\" 풀 앞에 서고, 붙어요). 묶음으로 오른쪽 면 위 모서리로 올라가, 열고, 오른쪽 가장자리를 따라 그녀에게."
          }
        }
      }
    },
    "order.hint1": {
      "comment": "Level \"order\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一次合里先滚后粘：合之前对着纸的胶，合的那一拍对着石头。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In one close the roll comes before the glue: glue that faced paper before the close faces a stone at the press."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ一回の閉じで、転がりが糊より先。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 닫는 동안 구르기가 풀보다 먼저예요."
          }
        }
      }
    },
    "order.line": {
      "comment": "Level \"order\": one-line teaser. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
