        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shadow stops at the door."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "影は扉の前で止まる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림자는 문 앞에서 멈춘다."
          }
        }
      }
    },
    "shadeDoor.name": {
      "comment": "Level \"shadeDoor\": title. From fold-proto i18n.js.",
