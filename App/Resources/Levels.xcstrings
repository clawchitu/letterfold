    "jump.hint": {
      "comment": "Level \"jump\": hint. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "斜到 50°：去的路上页立过一次，远处那颗已经滚到第 7 列——它的影子落在 (3,4) 的缺口上，不在你照着图算的那格。走近处那颗的影子 (4,3)，下到 (3,4)，再到 (2,4)；放平、合上，叠合走法通到她。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lean to 50°: on the way the page passed upright and the far stone has rolled to column 7 — its shadow falls on the gap at (3,4), not where you worked it out from the drawing. Walk the near stone’s shadow at (4,3), down to (3,4), across to (2,4); flatten, close, and the stacks lead to her."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "50° まで傾ける：途中で頁が立ち、遠い石は 7 列目へ転がっている——影は (3,4) の隙間に落ちる。近い石の影 (4,3) を渡り、(3,4) へ、(2,4) へ。平らにして閉じれば束が彼女へ続く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "50°까지 기울여요: 가는 길에 페이지가 한 번 섰고, 먼 돌은 7열로 굴러갔어요. 그림자는 (3,4) 틈에 떨어져요. 가까운 돌의 그림자 (4,3)을 지나 (3,4)로, (2,4)로. 펴고 닫으면 묶음이 그녀에게 이어져요."
          }
        }
      }
    },
    "jump.hint1": {
      "comment": "Level \"jump\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "影子落在石头滚之后的位置，不是画出来的位置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shadow falls where the stone is after its roll, not where it was drawn."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "影は転がったあとの石の位置に落ちる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림자는 구른 뒤의 돌 자리에 떨어져요."
          }
        }
      }
    },
    "jump.line": {
      "comment": "Level \"jump\": one-line teaser. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
