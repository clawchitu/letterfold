    "bridge.hint": {
      "comment": "Level \"bridge\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合上手机，右边的纸板会正好盖住缺口。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the phone: the card on the right lands exactly over the gap."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマホを閉じると、右の厚紙がすき間にぴたりと重なる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폰을 닫으면 오른쪽 종이판이 틈 위에 꼭 맞게 겹쳐요."
          }
        }
      }
    },
    "bridge.line": {
      "comment": "Level \"bridge\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺口的对面，有一块纸板。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Across the gap, a scrap of card."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すき間の向こうに、厚紙が一枚。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "틈 건너편에, 종이판 한 장."
          }
        }
      }
    },
    "bridge.name": {
      "comment": "Level \"bridge\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桥"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "橋"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다리"
          }
        }
      }
    },
    "bridgeGlue.hint": {
      "comment": "Level \"bridgeGlue\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先合上一次，把石头粘到对岸。再打开到 75° 左右：纸片桥立着，新石头的影子正好落在桥头。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close once to glue the stone across. Then open to about 75°: the tabs stand, and the new stone’s shadow lands at the foot of the bridge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず一度閉じて、石を向こうへ貼りつける。75°ほどまで開く：紙片の橋が立ち、新しい石の影がちょうど橋のたもとに落ちる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 한 번 닫아 돌을 건너편에 붙여요. 75°쯤까지 펼쳐요: 종이 조각 다리가 서고, 새 돌의 그림자가 꼭 다리 발치에 떨어져요."
          }
        }
      }
    },
    "bridgeGlue.line": {
      "comment": "Level \"bridgeGlue\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桥头的缺口，要一道影子。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The gap at the foot of the bridge needs a shadow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "橋のたもとのすき間には、影がいる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다리 발치의 틈에는 그림자가 필요하다."
          }
        }
      }
    },
    "bridgeGlue.name": {
      "comment": "Level \"bridgeGlue\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桥与胶"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge and Glue"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "橋と糊"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다리와 풀"
          }
        }
      }
    },
    "bridgeShade.hint": {
      "comment": "Level \"bridgeShade\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿左页走到左下方。合到 60° 左右踩上影子，再打开到 80°：影子带你到第 4 列，这时纸片桥正立着。过桥，信在桥头。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk the left page to its lower left. Close to about 60° and step onto the shadow, then open to 80°: it carries you to column 4, and at 80° the tabs stand. Cross; the letter is at the foot of the bridge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左ページを左下へ歩く。60°ほどまで閉じて影に乗り、80°まで開く：影があなたを4列目へ運び、80°では紙片の橋が立っている。渡れば、手紙は橋のたもと。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼쪽 페이지를 왼쪽 아래로 걸어가요. 60°쯤까지 닫아 그림자에 올라서고, 80°까지 펼쳐요: 그림자가 나를 4열로 데려가고, 80°에서는 종이 조각 다리가 서 있어요. 건너면, 편지는 다리 발치에."
          }
        }
      }
    },
    "bridgeShade.hint1": {
      "comment": "Level \"bridgeShade\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把书打开一点，不是合上一点。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a little, not close a little."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少し開く。少し閉じるのではなく。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조금 펴요. 조금 닫는 게 아니라."
          }
        }
      }
    },
    "bridgeShade.line": {
      "comment": "Level \"bridgeShade\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桥立着的时候，影子也在。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While the bridge stands, the shadow is there too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "橋が立つあいだ、影もそこにある。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다리가 서 있는 동안, 그림자도 거기 있다."
          }
        }
      }
    },
    "bridgeShade.name": {
      "comment": "Level \"bridgeShade\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桥下影"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge and Shade"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "橋と影"
          }
        },
        "ko": {
