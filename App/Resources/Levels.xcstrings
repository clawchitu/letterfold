            "value": "立"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "立つ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일어서다"
          }
        }
      }
    },
    "standClose.hint": {
      "comment": "Level \"standClose\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿上边走到桥头，立起来过桥，沿立起的右页走到右下角，合上。合着往左走到底，再往下一格，打开：你在右页，信就在上面一格。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk the top row to the bridge, stand the page and cross, walk the standing right page down to its far corner, and close. Closed, go left to the end, one step down, then open: you are on the right page with the letter one square up."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "（TODO ja）上の列を橋まで歩き、立てて渡り、立った右ページを隅まで下りて閉じる。閉じたまま左端へ、一枡下がって開く。手紙は一枡上。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "(TODO ko) 윗줄을 따라 다리로, 세워서 건너고, 선 오른쪽 페이지를 구석까지 내려가 닫아요. 닫은 채 왼쪽 끝으로, 한 칸 내려가 펼쳐요. 편지는 한 칸 위."
          }
        }
      }
    },
    "standClose.hint1": {
      "comment": "Level \"standClose\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立起的页，走到哪里再合？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How far along the standing page before you close?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "立ったページをどこまで歩いて閉じる？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선 페이지를 어디까지 걷고 닫을까?"
          }
        }
      }
    },
    "standClose.line": {
      "comment": "Level \"standClose\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桥在上面，信在墙后。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bridge above, the letter behind the wall."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "橋は上に、手紙は壁のうしろに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다리는 위에, 편지는 벽 뒤에."
          }
        }
      }
    },
    "standClose.name": {
      "comment": "Level \"standClose\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "墙角"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Corner"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "隅"
          }
        },
        "ko": {
          "stringUnit": {
