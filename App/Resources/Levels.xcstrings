    "twiceClosed.hint": {
      "comment": "Level \"twiceClosed\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先合上一次：胶把石头粘到右页顶上。合着走到左页第 3 行，打开到 30°：影子落在第 2 列。从石头的旧位走上去，打开到 55°，影子带你到第 3 列；往下走，下页石头的影子接到最后一格纸。只有那一格合上是安全的——在那里合，终点就在脚下。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close once: the glue pulls the stone to the top of the right page. Closed, walk to row 3 of the left page and open to 30°: the shadow is in column 2. Step on from the stone’s old place, open to 55°, and it carries you to column 3; walk down, the lower stone’s shadow reaches the last paper. Only that cell is safe to close from. Close there: the letter is under your feet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度閉じる。糊が石を右頁の上へ引く。閉じたまま左頁の3行目へ歩き、30°まで開く。影は2列目。石の元の場所から乗り、55°まで開くと3列目へ。下へ歩くと、下の石の影が最後の紙に届く。閉じて安全なのはその一枡だけ。そこで閉じれば、手紙は足元に。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 닫아요. 풀이 돌을 오른쪽 페이지 위로 붙여요. 닫은 채 왼쇽 페이지 3행으로 걸어가 30°로 펼쳐요. 그림자는 2열. 돌의 옛 자리에서 올라서고 55°로 펼치면 3열로. 아래로 걸으면 아래 돌의 그림자가 마지막 종이에 닿아요. 닫아도 안전한 칸은 그 한 칸뿐. 거기서 닫으면 편지는 발밑에."
          }
        }
      }
    },
    "twiceClosed.hint1": {
      "comment": "Level \"twiceClosed\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第二次合上，站在哪？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The second close: from where?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "二度目は、どこで閉じる？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 번째 닫기, 어디서?"
          }
        }
      }
    },
