    "inkBridge.hint": {
      "comment": "Level \"inkBridge\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先踩过墨走到桥头，合上：墨印到了右页。半开过桥，沿右页往下走，踩着印过去的墨到右页下方，再合上——这一叠下面是石头。合着往右一格就是信。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step over the ink to the tab and close: the ink prints across. Half-open, cross, walk down the right page over the printed ink, and close again — this stack sits on a stone. Closed, one step right is the letter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "墨を踏んで紙片まで歩き、閉じる：墨が右ページに写る。半開きで渡り、右ページを下りながら写った墨を踏んで、また閉じる——この重なりの下は石。閉じたまま右へ一歩が手紙。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먹을 밟고 종이 조각까지 걸어가 닫아요: 먹이 오른쪽 페이지에 찍혀요. 반쯤 열어 건너고, 오른쪽 페이지를 내려가며 찍힌 먹을 밟고, 다시 닫아요—이 겹 아래는 돌이에요. 닫은 채 오른쪽으로 한 칸이 편지."
          }
        }
      }
    },
    "inkBridge.hint1": {
      "comment": "Level \"inkBridge\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桥那头缺的一格，谁来补？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who fills the missing square past the bridge?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "橋の先の足りない一マスを、誰が埋める？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다리 너머 빈 한 칸은 누가 채우지?"
          }
        }
      }
    },
    "inkBridge.line": {
      "comment": "Level \"inkBridge\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桥的那头，路断了。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Past the bridge the path breaks off."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "橋の先で、道が切れている。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다리 너머에서 길이 끊긴다."
          }
        }
      }
    },
    "inkBridge.name": {
      "comment": "Level \"inkBridge\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
