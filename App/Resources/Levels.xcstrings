        }
      }
    },
    "roll.hint": {
      "comment": "Level \"roll\": hint. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "斜起到 80°：页经过立起那一下，松石往折痕滚一格，掉进你旁边的缺口——缺口成了纸。走过去。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lean to 80°: as the page passes upright the loose stone rolls one square towards the crease and drops into the gap beside you — the gap is paper now. Walk across."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "80° まで傾ける：頁が立った拍子に石が折り目へ一枡転がり、隣の隙間に落ちる——隙間は紙になった。渡る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "80°까지 기울여요: 페이지가 서는 순간 돌이 접힌 금 쪽으로 한 칸 굴러 옆 틈에 떨어져요. 틈은 종이가 됐어요. 건너가요."
          }
        }
      }
    },
    "roll.hint1": {
      "comment": "Level \"roll\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "书立起来，石头就往折痕滚；不用合上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand the book up and the stone rolls to the crease; no close needed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本を立てれば石は折り目へ転がる。閉じなくていい。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "책을 세우면 돌이 접힌 금으로 굴러요. 닫지 않아도 돼요."
          }
        }
      }
    },
    "roll.line": {
      "comment": "Level \"roll\": one-line teaser. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "石头没粘住。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The stone is not glued down."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "石は貼られていない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "돌이 붙어 있지 않아요."
          }
        }
      }
    },
    "roll.name": {
      "comment": "Level \"roll\": title. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
