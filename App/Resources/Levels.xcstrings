    "rideBack.hint": {
      "comment": "Level \"rideBack\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿左边走到左下角。合到 50° 左右，踩上影子，再打开到 80°：影子带你到第 4 列，旁边那格纸是唯一的岸。下去，在岸上合上，合着往右走就是信。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk the left edge to the bottom-left corner. Close to about 50°, step onto the shadow, then open to 80°: it carries you to column 4, beside the only square of shore. Step down, close on the shore, and walk the stack right to the letter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "（TODO ja）左端を左下まで。50°ほどまで閉じて影に乗り、80°まで開く。影が4列目へ運ぶ。となりの紙が唯一の岸。降りて岸で閉じ、右へ歩けば手紙。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "(TODO ko) 왼쪽 끝을 따라 왼쪽 아래로. 50° 정도까지 닫아 그림자에 올라, 80°까지 펼쳐요. 4열로 데려가요. 옆의 종이가 유일한 강가. 내려가 거기서 닫고, 오른쪽으로 걸으면 편지."
          }
        }
      }
    },
    "rideBack.hint1": {
      "comment": "Level \"rideBack\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "那格纸，怎么才到得了？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That square of paper: how do you reach it?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その一枡の紙へ、どうやって？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 한 칸 종이, 어떻게 가지?"
          }
        }
      }
    },
    "rideBack.line": {
      "comment": "Level \"rideBack\": one-line teaser. From fold-proto i18n.js.",
