    "land.hint": {
      "comment": "Level \"land\": hint. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你站在左页，鹤在右页——合上书：它飞到你这页的镜像格，正好落在缺口里。打开，缺口是纸了，走过去。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are on the left page, the crane on the right — close the book: it flies to the mirror square on your page, right into the gap. Open: the gap is paper now. Walk across."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "きみは左頁、鶴は右頁——本を閉じる：鶴はこちらの頁の鏡の枡、ちょうど隙間へ降りる。開けば隙間は紙。渡る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "너는 왼쪽 면, 학은 오른쪽 면——책을 닫아요: 학이 이쪽 면의 거울 칸, 바로 그 틈에 내려앉아요. 열면 틈은 종이예요. 건너가요."
          }
        }
      }
    },
    "land.hint1": {
      "comment": "Level \"land\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
