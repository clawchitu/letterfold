    "hover.hint": {
      "comment": "Level \"hover\": hint. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "斜到 60°（这一关唯一一次过立），走到鹤 (8,3) 上合书：它带你到 (1,3)。只开到 30°——别摊平，摊平又是一次过立，松石会滚到你要走的格上。走到飞过来的鹤 (3,4) 上，再合：它带你到 (6,4)。开到 55°，往下一格是她。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lean to 60° (the only pass in this letter), walk onto the crane (8,3) and close: it carries you to (1,3). Open only to 30° — not flat: flat is another pass, and the loose stones roll onto your squares. Walk onto the crane that flew to (3,4) and close again: it carries you to (6,4). Open to 55°; she is one step down."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "60° に傾け（ただ一度の立ち）、鶴 (8,3) に乗って閉じる：(1,3) へ。30° まで開く——寝かせない。飛んできた鶴 (3,4) に乗ってまた閉じる：(6,4) へ。55° まで開いて、一つ下が彼女。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "60°로 기울이고(단 한 번 서기), 학 (8,3)에 올라 닫아요: (1,3)으로. 30°까지만 열어요——눕히지 말고요. 날아온 학 (3,4)에 올라 다시 닫아요: (6,4)로. 55°까지 열면 한 칸 아래가 그녀예요."
          }
        }
      }
    },
    "hover.hint1": {
      "comment": "Level \"hover\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从合着开到斜着，不过 90°：再合一次，石头一格没动。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From closed to a lean is not a pass: close again and no stone has moved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じた本を傾けるまで開いても、90° は越えない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫힌 책을 기울기까지만 열면 90°를 넘지 않아요."
          }
        }
      }
    },
    "hover.line": {
      "comment": "Level \"hover\": one-line teaser. From fold-proto i18n.js. ja/ko: TODO-native-check.",
