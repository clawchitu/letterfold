        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The door is at the far end of the bridge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "扉は橋の向こう端に。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문은 다리 저쪽 끝에."
          }
        }
      }
    },
    "doorBridge.name": {
      "comment": "Level \"doorBridge\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "门与桥"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Door and Bridge"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "扉と橋"
          }
        },
        "ko": {
