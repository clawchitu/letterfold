    "twoShades.hint": {
      "comment": "Level \"twoShades\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿左边走到左上角。斜起到 55° 左右，影子落在第 3 列；站上去，再打开到 70°：影子带你到第 4 列。顺着第 4 列往下走，信就在左边。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk the left edge to the top-left corner. Lean to about 55°: the shadow falls in column 3. Step on, then open to 70°: it carries you to column 4. Walk down column 4; the letter is on your left."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "（TODO ja）左端を左上まで。55°ほどに傾けると影が3列目に。乗って70°まで開く。影が4列目へ運ぶ。4列目を下れば手紙は左。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "(TODO ko) 왼쪽 끝을 따라 왼왽 위로. 55° 정도 기울이면 그림자가 3열에. 올라서 70°까지 펼쳐요. 4열로 데려가요. 4열을 내려가면 편지는 왼쪽에."
          }
        }
      }
    },
    "twoShades.hint1": {
      "comment": "Level \"twoShades\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "影子往哪边走，取决于你怎么动书。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which way the shadow carries you depends on which way you move the book."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "影がどちらへ運ぶかは、本をどちらへ動かすか。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림자가 어디로 데려가는지는 책을 어디로 움직이는지에 달려요."
          }
        }
      }
    },
    "twoShades.line": {
      "comment": "Level \"twoShades\": one-line teaser. From fold-proto i18n.js.",
