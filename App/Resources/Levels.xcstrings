        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The far shadow moves faster."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遠い影は速い。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼 그림자가 빠르다."
          }
        }
      }
    },
    "lock.name": {
      "comment": "Level \"lock\": title. From fold-proto i18n.js.",
