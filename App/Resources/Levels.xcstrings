    "pocket.hint": {
      "comment": "Level \"pocket\": hint. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一上来就合：墨印到左页，叠合走法穿过右边那列墨、从顶上那叠换到左页。斜到 50°：粘过来的石头把影子投在它留下的洞旁边，乘到 80° 落到第 4 列的缺口，下一格是孤立的纸。在那合第二次，叠合走法通到她的门口。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close at once: the ink prints across, and the stack walk runs through the right-edge prints and changes page at the top stack. Lean to 50°: the stone the glue pulled in now shades the square beside the hole it left; ride to 80° onto the column-4 gap, and the paper below is an island. Close there a second time: the stacks lead to her door."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "（TODO ja）すぐ閉じる：墨が左頁に写り、束の道は右端の墨を通って上の束で左頁へ移る。50° に傾ける：糊が引いた石が、残した穴のそばに影を落とす。80° まで乗って 4 列目の隙間へ、下の枡は孤島の紙。そこで二度目を閉じると、束が彼女の戸口へ続く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "(TODO ko) 바로 닫아요: 먹이 왼쪽 면에 찍히고, 묶음 길은 오른쪽 가장자리의 먹을 지나 맨 위 묶음에서 왼쪽 면으로 건너가요. 50°로 기울여요: 풀이 끌어온 돌이 자기가 남긴 구멍 옆에 그림자를 드리워요. 80°까지 타고 4열 틈으로, 아래 칸은 외딴 종이. 거기서 두 번째로 닫으면 묶음이 그녀의 문 앞까지 이어져요."
          }
        }
      }
    },
    "pocket.hint1": {
      "comment": "Level \"pocket\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "胶在墨到之前就粘了；它粘来的石头堵在她门口。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The glue fires before the ink reaches it — and the stone it pulls sits in her doorway."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "墨が届く前に糊が貼りつく——引いた石が彼女の戸口を塞ぐ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먹이 닿기 전에 풀이 붙어요. 끌려온 돌이 그녀의 문을 막아요."
          }
        }
      }
    },
    "pocket.line": {
      "comment": "Level \"pocket\": one-line teaser. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "墨离胶两格。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ink is two squares from the glue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "墨は糊から二枡。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먹은 풀에서 두 칸."
          }
        }
      }
    },
    "pocket.name": {
      "comment": "Level \"pocket\": title. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
