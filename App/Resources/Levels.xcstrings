            "value": "立"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "立つ"
          }
        },
        "ko": {
          "stringUnit": {
