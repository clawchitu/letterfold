{
  "sourceLanguage": "en",
  "strings": {
    "back.hint": {
      "comment": "Level \"back\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合上过去，展开走一段，再合上回到左页。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close to cross, open to walk a while, then close again to come back to the left page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じて渡り、開いて少し歩き、また閉じて左ページへ戻る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫아서 건너고, 펼쳐서 조금 걷고, 다시 닫아 왼쪽 페이지로 돌아와요."
          }
        }
      }
    },
    "back.line": {
      "comment": "Level \"back\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过去，再回来。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over, and home again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行って、また帰る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건너갔다가, 다시 돌아오기."
          }
        }
      }
    },
    "back.name": {
      "comment": "Level \"back\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "往返"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There and Back"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行き帰り"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오가는 길"
          }
        }
      }
    },
    "bridge.hint": {
      "comment": "Level \"bridge\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合上手机，右边的纸板会正好盖住缺口。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the phone: the card on the right lands exactly over the gap."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマホを閉じると、右の厚紙がすき間にぴたりと重なる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폰을 닫으면 오른쪽 종이판이 틈을 꼭 덮어요."
          }
        }
      }
    },
    "bridge.line": {
      "comment": "Level \"bridge\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺口的对面，有一块纸板。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Across the gap, a scrap of card."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すき間の向こうに、厚紙が一枚。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "틈 건너편에 종이판 한 장."
          }
        }
      }
    },
    "bridge.name": {
      "comment": "Level \"bridge\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桥"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "橋"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다리"
          }
        }
      }
    },
    "bridgeGlue.hint": {
      "comment": "Level \"bridgeGlue\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先合上一次，把石头粘到对岸。再打开到 75° 左右：纸片桥立着，新石头的影子正好落在桥头。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close once to glue the stone across. Then open to about 75°: the tabs stand, and the new stone’s shadow lands at the foot of the bridge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず一度閉じて石を向こう岸へ貼りつける。75°くらいまで開く。紙片の橋は立ったまま、新しい石の影がたもとに落ちる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 한 번 닫아 돌을 건너편에 붙여요. 75° 정도로 펼쳐요. 종이 조각 다리는 서 있고, 새 돌의 그림자가 다리 밑에 떨어져요."
          }
        }
      }
    },
    "bridgeGlue.line": {
      "comment": "Level \"bridgeGlue\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桥头的缺口，要一道影子。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The gap at the foot of the bridge needs a shadow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "橋のたもとのすき間には、影がいる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다리 밑 틈에는 그림자가 필요하다."
          }
        }
      }
    },
    "bridgeGlue.name": {
      "comment": "Level \"bridgeGlue\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桥与胶"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge and Glue"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "橋と糊"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다리와 풀"
          }
        }
      }
    },
    "bridgeShade.hint": {
      "comment": "Level \"bridgeShade\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先合上一次开门。再把书打开到 75° 左右：纸片桥还立着，远处石头的影子正好落在桥头的缺口上。过桥、踩影子、走到岸。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close once to open the door. Then open the book to about 75°: the tabs still stand, and the far stone’s shadow lands on the gap at the foot of the bridge. Cross, step on the shadow, walk to the shore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず一度閉じて扉を開ける。それから本を75°ほどまで開く。紙片の橋はまだ立ち、遠い石の影が橋のたもとのすき間に落ちる。渡り、影を踏み、岸へ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 한 번 닫아 문을 열어요. 그다음 책을 75° 정도까지 펼쳐요. 종이 다리는 아직 서 있고, 먼 돌의 그림자가 다리 발치의 틈에 떨어져요. 건너서 그림자를 밟고 강가로 걸어요."
          }
        }
      }
    },
    "bridgeShade.line": {
      "comment": "Level \"bridgeShade\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桥立着的时候，影子也在。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While the bridge stands, the shadow is there too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "橋が立っている間、影もそこにある。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다리가 선 동안, 그림자도 거기 있다."
          }
        }
      }
    },
    "bridgeShade.name": {
      "comment": "Level \"bridgeShade\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桥下影"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge and Shade"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "橋と影"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다리와 그림자"
          }
        }
      }
    },
    "crease.hint": {
      "comment": "Level \"crease\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先合上一次，钥匙和墨都印过去；再半开过桥，走到门边，最后合上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close once so the key and the ink carry across; half-open and cross the bridge, walk to the door, then close."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず一度閉じて鍵と墨を写す。半分開いて橋を渡り、扉まで歩いて、最後に閉じる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 한 번 닫아 열쇠와 먹을 찍어요. 반쯤 열어 다리를 건너 문까지 걷고, 마지막에 닫아요."
          }
        }
      }
    },
    "crease.line": {
      "comment": "Level \"crease\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用上你学会的一切。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything you have learned."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "覚えたすべてを。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배운 모든 것을."
          }
        }
      }
    },
    "crease.name": {
      "comment": "Level \"crease\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "折痕"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crease"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "折り目"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접힌 자국"
          }
        }
      }
    },
    "doorBridge.hint": {
      "comment": "Level \"doorBridge\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先合上让钥匙开门，再打开到一半，从立起的纸片走过去。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close so the key opens the door, then open halfway and cross on the standing tabs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じて鍵で扉を開け、半分開いて、立った紙片を渡る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫아서 열쇠로 문을 열고, 반쯤 열어 일어선 종이 조각을 건너요."
          }
        }
      }
    },
    "doorBridge.line": {
      "comment": "Level \"doorBridge\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先开门，再过桥。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First the door, then the bridge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず扉、それから橋。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 문, 그다음 다리."
          }
        }
      }
    },
    "doorBridge.name": {
      "comment": "Level \"doorBridge\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "门与桥"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Door, then Bridge"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "扉と橋"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문과 다리"
          }
        }
      }
    },
    "facing.hint": {
      "comment": "Level \"facing\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合上，走到右页的路上；石头挡住了，就展开继续走。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close, and step onto the right page’s path; when a stone blocks you, open and walk on."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じて右ページの道へ。石にふさがれたら、開いて先へ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫고 오른쪽 페이지의 길로 건너가요. 돌이 막으면 펼쳐서 계속 걸어요."
          }
        }
      }
    },
    "facing.line": {
      "comment": "Level \"facing\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终点在另一页。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The goal lies on the other page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴールは、もう一枚のページに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도착점은 다른 페이지에."
          }
        }
      }
    },
    "facing.name": {
      "comment": "Level \"facing\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对页"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Facing Page"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見開き"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "맞은편"
          }
        }
      }
    },
    "glue.hint": {
      "comment": "Level \"glue\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合上一次：对面的胶会把石头粘过去。打开，路就空了。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close once: the glue opposite pulls the stone across. Open, and the road is clear."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度閉じる。向かいの糊が石を引き寄せる。開けば、道は空いている。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 닫아요. 맞은편 풀이 돌을 붙여 가요. 펼치면 길이 비어 있어요."
          }
        }
      }
    },
    "glue.line": {
      "comment": "Level \"glue\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "路上有石头，对岸有胶。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A stone on your road; glue on the far bank."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "道に石、向こう岸に糊。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길에 돌, 건너편에 풀."
          }
        }
      }
    },
    "glue.name": {
      "comment": "Level \"glue\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "胶"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glue"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "糊"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "풀"
          }
        }
      }
    },
    "ink.hint": {
      "comment": "Level \"ink\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合上一次：墨印到右页，你也顺着叠在一起的纸走到右页。打开，踩着印过去的墨走到信前。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close once: the ink prints onto the right page, and you walk across the stacked pages onto it. Open, and walk the printed ink to the letter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度閉じる。墨が右ページに写り、重なった紙を伝ってあなたも右ページへ。開いて、写った墨を踏んでゴールまで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 닫아요. 먹이 오른쪽 페이지에 찍히고, 겹친 종이를 따라 나도 오른쪽으로 건너가요. 펼친 다음 찍힌 먹을 밟고 도착점까지 걸어요."
          }
        }
      }
    },
    "ink.line": {
      "comment": "Level \"ink\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "墨还没干。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ink is still wet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "墨はまだ乾いていない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먹이 아직 마르지 않았다."
          }
        }
      }
    },
    "ink.name": {
      "comment": "Level \"ink\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "墨"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ink"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "墨"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먹"
          }
        }
      }
    },
    "inkBridge.hint": {
      "comment": "Level \"inkBridge\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合上时石头会压住终点，所以只合一下：让墨印过去，再半开过桥。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing drops the stone on the goal, so close only once: let the ink print across, then half-open and cross."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じると石がゴールをふさぐ。だから一度だけ閉じて墨を写し、半分開いて橋を渡る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫으면 돌이 도착점을 눌러요. 그러니 한 번만 닫아 먹을 찍고, 반쯤 열어 다리를 건너요."
          }
        }
      }
    },
    "inkBridge.line": {
      "comment": "Level \"inkBridge\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桥的那头，路断了；终点被压住了。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Past the bridge the path breaks off; the goal is pinned down."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "橋の先で道は途切れ、ゴールは押さえられている。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다리 너머 길은 끊기고, 도착점은 눌려 있다."
          }
        }
      }
    },
    "inkBridge.name": {
      "comment": "Level \"inkBridge\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "墨与桥"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ink, then Bridge"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "墨と橋"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먹과 다리"
          }
        }
      }
    },
    "inkShore.hint": {
      "comment": "Level \"inkShore\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站在影子上合书，你会掉下去。先合上一次，让墨印到对岸那格缺口上——那就是岸。打开，斜起到 60°，走过影子站到墨上，再合上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the book while standing on a shadow and you fall. Close once first, so the ink prints onto the gap across the way: that is your shore. Open, lean to 60°, cross the shadow onto the ink, then close."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "影の上で本を閉じれば落ちる。まず一度閉じ、向かいのすき間に墨を写す。それが岸。開いて60°まで傾け、影をわたって墨の上に立ち、閉じる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림자 위에서 책을 닫으면 떨어져요. 먼저 한 번 닫아 맞은편 틈에 먹을 찍어요. 그게 강가예요. 펼쳐서 60°로 기울이고, 그림자를 건너 먹 위에 선 다음 닫아요."
          }
        }
      }
    },
    "inkShore.line": {
      "comment": "Level \"inkShore\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "影子是路，不是岸。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A shadow is a road, not a shore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "影は道であって、岸ではない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림자는 길이지, 강가가 아니다."
          }
        }
      }
    },
    "inkShore.name": {
      "comment": "Level \"inkShore\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "墨岸"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ink Shore"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "墨の岸"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먹의 강가"
          }
        }
      }
    },
    "inkTwice.hint": {
      "comment": "Level \"inkTwice\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合上一次，墨印到墙上；立起来走过它；再合上一次。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close once so the ink prints onto the wall; stand and walk across it; close once more."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度閉じて、墨を壁に写す。立てて、その上を渡る。もう一度閉じる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 닫아 먹을 벽에 찍어요. 세워서 그 위를 건너요. 다시 한 번 닫아요."
          }
        }
      }
    },
    "inkTwice.line": {
      "comment": "Level \"inkTwice\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "墨先去，人再去。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ink first, then you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "墨が先、人は後。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먹이 먼저, 사람은 나중에."
          }
        }
      }
    },
    "inkTwice.name": {
      "comment": "Level \"inkTwice\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两次合"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close Twice"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "二度閉じる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 번 닫기"
          }
        }
      }
    },
    "key.hint": {
      "comment": "Level \"key\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钥匙和门左右对称。合上，它们就碰到了。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Key and door mirror each other. Close, and they meet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵と扉は左右対称。閉じれば、ふれあう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열쇠와 문은 좌우 대칭이에요. 닫으면 서로 닿아요."
          }
        }
      }
    },
    "key.line": {
      "comment": "Level \"key\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "门锁着，钥匙在对页。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The door is locked. The key is on the facing page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "扉は閉ざされ、鍵は向かいのページに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문은 잠겼고, 열쇠는 맞은편에."
          }
        }
      }
    },
    "key.name": {
      "comment": "Level \"key\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钥匙"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Key"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열쇠"
          }
        }
      }
    },
    "lamp.hint": {
      "comment": "Level \"lamp\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "别先合上——头顶那块石头会压下来。站上影子慢慢合书；两道影子排成一列时，往下走到纸上。再合上：终点在对页。书合拢之前，一定要先离开影子。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not close first: the stone over your head comes down. Stand on a shadow and close slowly; where the two shadows line up, step down onto the paper. Then close: the goal is on the facing page. Get off the shadow before the book shuts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に閉じないこと。頭の上の石が落ちてくる。影に乗ってゆっくり閉じる。二つの影がそろったら、下の紙へ降りる。それから閉じる。ゴールは向かいのページ。閉じきる前に、かならず影から降りること。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 닫지 마세요. 머리 위 돌이 내려와요. 그림자 위에 서서 천천히 닫아요. 두 그림자가 나란히 서면 아래 종이로 내려가요. 그다음 닫아요. 도착점은 맞은편 페이지예요. 책이 닫히기 전에 꼭 그림자에서 내려와요."
          }
        }
      }
    },
    "lamp.line": {
      "comment": "Level \"lamp\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "走过影子，再把信合上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk the shadows, then fold the letter shut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "影をわたって、手紙を閉じる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림자를 건너, 편지를 덮는다."
          }
        }
      }
    },
    "lamp.name": {
      "comment": "Level \"lamp\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灯下"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By Lamplight"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "灯の下"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "등불 아래"
          }
        }
      }
    },
    "lend.hint": {
      "comment": "Level \"lend\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先合上一次，胶把这边的石头粘到对岸去。打开，再斜起到 30°–50°：它的影子落在缺口上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close once, and the glue carries this stone to the far page. Open, then lean to 30°–50°: its shadow falls on the gap."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず一度閉じて、糊でこちらの石を向こう岸へ送る。開いて、30°〜50°まで傾ける。その影がすき間に落ちる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 한 번 닫아요. 풀이 이쪽 돌을 건너편으로 보내요. 펼치고 30°~50°로 기울여요. 그 그림자가 틈 위에 떨어져요."
          }
        }
      }
    },
    "lend.line": {
      "comment": "Level \"lend\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对岸没有石头，就没有影子。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No stone on the far page, so no shadow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "向こうの頁に石がなければ、影もない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건너편 페이지에 돌이 없으면 그림자도 없다."
          }
        }
      }
    },
    "lend.name": {
      "comment": "Level \"lend\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "借石"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrowed Stone"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "借りた石"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빌린 돌"
          }
        }
      }
    },
    "lock.hint": {
      "comment": "Level \"lock\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个缺口要同时有影子。再慢慢合一点，直到两道影子排成一列——就在书快要合上之前。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both gaps need a shadow at once. Keep closing slowly until the two shadows line up, just before the book shuts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "二つのすき間に、同時に影がいる。ゆっくり閉じていき、二つの影が一列にそろったら止める。閉じきる少し手前。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 틈에 동시에 그림자가 있어야 해요. 천천히 더 닫아 두 그림자가 한 줄로 서면 멈춰요. 다 닫히기 바로 전이에요."
          }
        }
      }
    },
    "lock.line": {
      "comment": "Level \"lock\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远的石头，影子走得快。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The farther the stone, the faster its shadow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遠い石ほど、影は速く動く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼 돌일수록 그림자는 빨리 움직인다."
          }
        }
      }
    },
    "lock.name": {
      "comment": "Level \"lock\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远近"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Near and Far"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遠近"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "멀고 가까운"
          }
        }
      }
    },
    "oneClose.hint": {
      "comment": "Level \"oneClose\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站在胶上合，石头落在你头上；站在胶上面合，石头落在路上，你回不去了。先走到胶的下面，再合上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close on the glue and the stone lands on you; close above it and the stone lands on your road, and you cannot get back. Walk below the glue first, then close."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "糊の上で閉じれば石が頭に落ちる。糊の上側で閉じれば石が道に落ち、戻れなくなる。まず糊の下まで歩いて、閉じる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "풀 위에서 닫으면 돌이 머리 위로 떨어져요. 풀 위쪽에서 닫으면 돌이 길에 떨어져 돌아갈 수 없어요. 먼저 풀 아래까지 걸어가서 닫아요."
          }
        }
      }
    },
    "oneClose.line": {
      "comment": "Level \"oneClose\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只合一次。在哪里合？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close only once. But where?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じるのは一度。でも、どこで？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번만 닫아요. 그런데 어디서?"
          }
        }
      }
    },
    "oneClose.name": {
      "comment": "Level \"oneClose\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一合"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One Close"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度だけ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번만"
          }
        }
      }
    },
    "press.hint": {
      "comment": "Level \"press\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合上时纸板盖住缺口，可石头会压在缺口后面的路上。只斜起：石头的影子就是桥。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing lays the card over the gap, but drops the stone on the road beyond it. Only lean the page: the stone’s shadow is the bridge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じると厚紙がすき間をふさぐが、石がその先の道に落ちてくる。斜めに起こすだけ。石の影が橋になる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫으면 종이판이 틈을 덮지만, 돌이 그 너머 길에 떨어져요. 비스듬히 세우기만 하세요. 돌의 그림자가 다리예요."
          }
        }
      }
    },
    "press.line": {
      "comment": "Level \"press\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纸板在对岸，石头也在。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The card is on the far bank. So is the stone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "厚紙は向こう岸に。石も。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종이판은 건너편에 있다. 돌도."
          }
        }
      }
    },
    "press.name": {
      "comment": "Level \"press\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weight"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "圧"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누름"
          }
        }
      }
    },
    "ride.hint": {
      "comment": "Level \"ride\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站到影子上，再慢慢合书：影子会带着你一起滑过去。合到底石头就压下来了。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand on the shadow, then close the book slowly: it carries you across. Close all the way and the stone comes down."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "影の上に立って、ゆっくり本を閉じる。影があなたを乗せて滑っていく。閉じきると石が落ちてくる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림자 위에 서서 책을 천천히 닫아요. 그림자가 나를 태우고 미끄러져요. 끝까지 닫으면 돌이 내려와요."
          }
        }
      }
    },
    "ride.line": {
      "comment": "Level \"ride\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺口太宽，影子太短。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The gap too wide, the shadow too short."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すき間は広く、影は短い。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "틈은 너무 넓고, 그림자는 너무 짧다."
          }
        }
      }
    },
    "ride.name": {
      "comment": "Level \"ride\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "乘影"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shadow Ride"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "影に乗る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림자를 타고"
          }
        }
      }
    },
    "rideBack.hint": {
      "comment": "Level \"rideBack\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "书几乎合上时，影子才伸到你脚边。站上去，再把书打开：影子带你回到折痕边。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only when the book is nearly shut does the shadow reach your feet. Step on, then open the book: the shadow carries you back to the crease."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほとんど閉じたときだけ、影が足もとまで届く。乗ったら本を開く。影があなたを折り目のそばまで運ぶ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거의 닫혔을 때만 그림자가 발밑까지 와요. 올라선 다음 책을 펼쳐요. 그림자가 접는 선 가까이로 데려다줘요."
          }
        }
      }
    },
    "rideBack.line": {
      "comment": "Level \"rideBack\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "影子会走，也会回来。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A shadow goes out, and comes back."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "影は出ていき、また戻ってくる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림자는 나갔다가, 다시 돌아온다."
          }
        }
      }
    },
    "rideBack.name": {
      "comment": "Level \"rideBack\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回程"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Way Back"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "帰り道"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "돌아오는 길"
          }
        }
      }
    },
    "rideFirst.hint": {
      "comment": "Level \"rideFirst\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合上时胶会把石头粘到这边来，影子就没了。所以先斜起到 60°，踩上影子，再慢慢合到 45°：影子带你过去。下到纸上，再合上——钥匙开门。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing lets the glue pull the stone to this page, and the shadow goes with it. So lean to 60° first, step on the shadow, and close slowly to 45°: it carries you across. Step down onto the paper, then close: the key opens the door."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じれば糊が石をこちらの頁へ引き寄せ、影も消える。だからまず60°まで傾けて影に乗り、ゆっくり45°まで閉じる。影が運んでくれる。紙に降りて、閉じる。鍵が扉を開ける。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫으면 풀이 돌을 이쪽 페이지로 붙여 가고 그림자도 사라져요. 그러니 먼저 60°로 기울여 그림자에 올라서고, 천천히 45°까지 닫아요. 그림자가 데려다 줘요. 종이로 내려와서 닫아요. 열쇠가 문을 열어요."
          }
        }
      }
    },
    "rideFirst.line": {
      "comment": "Level \"rideFirst\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "影子会走，石头也会。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shadows move. So do stones."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "影は動く。石も動く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림자는 움직인다. 돌도 움직인다."
          }
        }
      }
    },
    "rideFirst.name": {
      "comment": "Level \"rideFirst\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先乘影"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ride First"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に影に乗る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 그림자를 타다"
          }
        }
      }
    },
    "rightBank.hint": {
      "comment": "Level \"rightBank\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合上一次：门开了，墨也印过去了。立起来过桥、穿门、踩着墨走到头，最后合上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close once: the door opens and the ink prints across. Stand, cross, go through the door, walk the ink to the end, then close."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度閉じる。扉が開き、墨も写る。立てて橋を渡り、扉を抜け、墨を踏んで端まで歩き、最後に閉じる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 닫아요. 문이 열리고 먹도 찍혀요. 세워서 다리를 건너 문을 지나고, 먹을 밟아 끝까지 걸은 뒤 마지막에 닫아요."
          }
        }
      }
    },
    "rightBank.line": {
      "comment": "Level \"rightBank\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信，在立起的那页上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The letter is on the standing page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手紙は、立った頁の上に。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편지는 일어선 페이지 위에."
          }
        }
      }
    },
    "rightBank.name": {
      "comment": "Level \"rightBank\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右岸"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Right Bank"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右岸"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 강가"
          }
        }
      }
    },
    "shadeDoor.hint": {
      "comment": "Level \"shadeDoor\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先合上一次，钥匙开门。再斜起到 75° 踩上影子，慢慢合到 45°：影子带你穿过开着的门，落在门后的纸上。另一道影子通向一座孤岛——别上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close once: the key opens the door. Lean to 75°, step on the shadow, and close slowly to 45°: it carries you through the open door onto the paper beyond. The other shadow leads to an island. Leave it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず一度閉じて鍵で扉を開ける。75°まで傾けて影に乗り、ゆっくり45°まで閉じる。影が開いた扉をくぐって、向こうの紙に降ろしてくれる。もう一つの影は孤島へ続く。乗らないこと。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 한 번 닫아 열쇠로 문을 열어요. 75°로 기울여 그림자에 올라서고, 천천히 45°까지 닫아요. 그림자가 열린 문을 지나 너머의 종이에 내려 줘요. 다른 그림자는 외딴 섬으로 이어져요. 타지 마세요."
          }
        }
      }
    },
    "shadeDoor.line": {
      "comment": "Level \"shadeDoor\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "影子过不了锁着的门。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A shadow cannot pass a locked door."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "影は、鍵のかかった扉を通れない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림자는 잠긴 문을 지나지 못한다."
          }
        }
      }
    },
    "shadeDoor.name": {
      "comment": "Level \"shadeDoor\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "门下影"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shade at the Door"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "扉の下の影"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문 아래 그림자"
          }
        }
      }
    },
    "shadow.hint": {
      "comment": "Level \"shadow\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把书慢慢合到一半多一点，右页石头的影子会落在缺口上。影子能走。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the book slowly, a little past halfway: the stone’s shadow falls across the gap. Shadows can be walked on."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本をゆっくり、半分より少しだけ閉じると、右ページの石の影がすき間に落ちる。影は歩ける。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "책을 천천히 반보다 조금 더 닫으면 오른쪽 돌의 그림자가 틈에 드리워요. 그림자 위로는 걸을 수 있어요."
          }
        }
      }
    },
    "shadow.line": {
      "comment": "Level \"shadow\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灯在纸的后面。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is a lamp behind the page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "紙のうしろに、灯がある。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종이 뒤에 등불이 있다."
          }
        }
      }
    },
    "shadow.name": {
      "comment": "Level \"shadow\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "影"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shade"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "影"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림자"
          }
        }
      }
    },
    "shadowFirst.hint": {
      "comment": "Level \"shadowFirst\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这块石头的影子是你唯一的桥——可是合上时胶会把它粘走。先斜起到 40° 左右，走过影子，站到对面那格纸上，再合上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This stone’s shadow is your only bridge, and closing lets the glue take the stone. Lean to about 40° first, cross the shadow onto the paper beyond, then close."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この石の影がただ一つの橋。けれど閉じれば糊が石を持っていく。まず40°くらいまで傾け、影を渡って向こうの紙に立ち、それから閉じる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 돌의 그림자가 유일한 다리인데, 닫으면 풀이 돌을 가져가요. 먼저 40° 정도로 기울여 그림자를 건너 건너편 종이에 서고, 그다음 닫아요."
          }
        }
      }
    },
    "shadowFirst.hint1": {
      "comment": "Level \"shadowFirst\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "别急着合上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not close yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ閉じないで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 닫지 마세요."
          }
        }
      }
    },
    "shadowFirst.line": {
      "comment": "Level \"shadowFirst\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "影子只借一次。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shadow is lent once."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "影は一度しか借りられない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림자는 한 번만 빌릴 수 있다."
          }
        }
      }
    },
    "shadowFirst.name": {
      "comment": "Level \"shadowFirst\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "影先"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shadow First"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "影が先"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림자 먼저"
          }
        }
      }
    },
    "stand.hint": {
      "comment": "Level \"stand\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把手机打开到一半，折痕上的纸片会立起来，连成一座桥。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the phone halfway: the tabs on the crease stand up and join into a bridge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマホを半分だけ開くと、折り目の紙片が立ち上がり、橋になる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폰을 반쯤 열면 접는 선의 종이 조각이 일어서서 다리가 돼요."
          }
        }
      }
    },
    "stand.line": {
      "comment": "Level \"stand\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合上也过不去。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even closed, there is no way across."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じても、渡れない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫아도 건널 수 없다."
          }
        }
      }
    },
    "stand.name": {
      "comment": "Level \"stand\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "立つ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일어서다"
          }
        }
      }
    },
    "standClose.hint": {
      "comment": "Level \"standClose\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先立起来过桥，在立起的页上一直走到头，再合上——终点就在脚下。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand the page and cross, walk to the end of the standing page, then close: the goal is right under you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページを立てて橋を渡り、立ったページを端まで歩いてから閉じる。ゴールは足もとにある。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지를 세워 다리를 건너고, 선 페이지를 끝까지 걸은 다음 닫아요. 도착점이 바로 발밑에 있어요."
          }
        }
      }
    },
    "standClose.line": {
      "comment": "Level \"standClose\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "墙上也能走。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can walk on the wall."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "壁の上も歩ける。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "벽 위도 걸을 수 있다."
          }
        }
      }
    },
    "standClose.name": {
      "comment": "Level \"standClose\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先立后合"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand, then Close"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "立ててから閉じる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세우고 닫기"
          }
        }
      }
    },
    "stoneRain.hint": {
      "comment": "Level \"stoneRain\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "路上每一格头顶都有石头，只有最后一格没有——合上之前先走到那里。墨印过去以后，斜起到 50° 左右踩上中间的影子，再慢慢打开到 75°：影子带你到墨边，下去。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every square of the road has a stone above it except the last: get there before you close. Once the ink has printed, lean to about 50°, step onto the middle shadow, then open slowly to 75°: the shadow carries you to the ink. Step down."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "道のどの枡の上にも石がある。最後の枡だけは違う。閉じる前にそこまで歩く。墨が写ったら、50°ほど傾けて真ん中の影に乗り、ゆっくり75°まで開く。影が墨のそばまで運ぶ。降りる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길의 모든 칸 위에 돌이 있어요. 마지막 칸만 빼고요. 닫기 전에 거기까지 걸어가요. 먹이 찍히면 50° 정도 기울여 가운데 그림자에 올라서고, 천천히 75°까지 펼쳐요. 그림자가 먹 옆까지 데려다줘요. 내려가요."
          }
        }
      }
    },
    "stoneRain.line": {
      "comment": "Level \"stoneRain\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三块石头悬在路上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three stones hang over the road."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "三つの石が道の上に吊られている。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "돌 세 개가 길 위에 매달려 있다."
          }
        }
      }
    },
    "stoneRain.name": {
      "comment": "Level \"stoneRain\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "石雨"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stone Rain"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "石の雨"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "돌 비"
          }
        }
      }
    },
    "stuckPage.hint": {
      "comment": "Level \"stuckPage\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站在胶上合书会被压住；在胶上面合书，石头会落在路上。先走到胶下面那格纸再合：门开了，石头也粘到了对岸。然后斜起到 60°，踩着新影子走到门口，最后合上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close while standing on the glue and you are crushed; close above it and the stone lands on your road. Walk to the paper below the glue, then close: the door opens, and a stone sticks to the far page. Lean to 60°, walk its new shadow to the door, and close."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "糊の上で閉じれば押しつぶされ、糊の上側で閉じれば石が道に落ちる。糊の下の紙まで歩いて閉じる。扉が開き、石が向こう岸に貼りつく。60°まで傾け、新しい影を渡って扉へ、最後に閉じる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "풀 위에서 닫으면 눌리고, 풀 위쪽에서 닫으면 돌이 길에 떨어져요. 풀 아래 종이까지 걸어가서 닫아요. 문이 열리고 돌이 건너편에 붙어요. 60°로 기울여 새 그림자를 밟고 문까지 간 뒤, 마지막으로 닫아요."
          }
        }
      }
    },
    "stuckPage.line": {
      "comment": "Level \"stuckPage\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两处胶同时粘。信，在门后。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two glues at once. The letter is behind the door."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "二つの糊が同時に。手紙は扉の向こう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 풀이 동시에. 편지는 문 뒤에."
          }
        }
      }
    },
    "stuckPage.name": {
      "comment": "Level \"stuckPage\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘住的页"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Stuck Page"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "貼りついた頁"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "붙은 페이지"
          }
        }
      }
    },
    "twoBridges.hint": {
      "comment": "Level \"twoBridges\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立起来：两座桥都在。走过上面那座，沿着立起的页走到底，从下面那座回来。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open halfway: both bridges stand. Cross the top one, walk down the standing page, come back over the bottom one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "半分だけ開くと、橋が二つ立つ。上の橋を渡り、立ったページを端まで歩いて、下の橋で戻る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반쯤 열면 다리 두 개가 서요. 위 다리를 건너 선 페이지를 끝까지 걷고, 아래 다리로 돌아와요."
          }
        }
      }
    },
    "twoBridges.line": {
      "comment": "Level \"twoBridges\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过去，再回来。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over, and back."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "渡って、戻る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건너갔다가, 돌아온다."
          }
        }
      }
    },
    "twoBridges.name": {
      "comment": "Level \"twoBridges\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两桥"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two Bridges"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "二つの橋"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 다리"
          }
        }
      }
    },
    "twoFigures.hint": {
      "comment": "Level \"twoFigures\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对岸的人在岸边等。先走到最下面那格纸，别站在石头正对面合书。书快合上时踩上影子，再打开：影子把你送回岸边。在那里合上——钥匙开门，两岸相触，你就站到了那个人的格子里。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other one waits at the edge of the far bank. Walk down to the last square of paper; do not close while standing opposite the stone. When the book is nearly shut, step onto the shadow, then open: it carries you back to the shore. Close there: the key opens the door, the two banks touch, and you are standing in their square."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "向こう岸の人が岸の縁で待っている。いちばん下の紙の枡まで歩く。石の真向かいでは閉じないこと。本がほとんど閉じたとき影に乗り、開く。影が岸まで送り返す。そこで閉じる。鍵が扉を開け、両岸がふれ、あなたはその人の枡に立っている。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건너편 사람이 강가 끝에서 기다려요. 맨 아래 종이 칸까지 걸어가요. 돌 맞은편에서는 닫지 마세요. 책이 거의 닫혔을 때 그림자에 올라서고, 펼쳐요. 그림자가 강가로 돌려보내 줘요. 거기서 닫아요. 열쇠가 문을 열고, 두 강가가 맞닿고, 당신은 그 사람의 칸에 서 있어요."
          }
        }
      }
    },
    "twoFigures.line": {
      "comment": "Level \"twoFigures\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两岸相触。信，到了。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The two banks touch. The letter has arrived."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両岸がふれる。手紙は、届いた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 강가가 맞닿는다. 편지가, 도착했다."
          }
        }
      }
    },
    "twoFigures.name": {
      "comment": "Level \"twoFigures\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两人"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two Figures"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "二人"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 사람"
          }
        }
      }
    },
    "twoShades.hint": {
      "comment": "Level \"twoShades\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "斜起到 75° 左右，踩上远处石头的影子，合到快合上：它把你放在岸边那一格纸上。就在那里，近处石头的影子刚好伸到脚边——站上去，再把书打开，它带你回到折痕边。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lean to about 75°, step on the far stone’s shadow and close almost all the way: it sets you down on the one square of paper. Right there the near stone’s shadow has just reached your feet. Step on it and open the book: it carries you back towards the crease."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "75°ほど傾け、遠い石の影に乗り、閉じる直前まで閉じる。岸の一枡の紙に降りる。そこへ近い石の影がちょうど届く。乗って本を開けば、折り目のそばへ戻れる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "75° 정도 기울여 먼 돌의 그림자에 올라서고, 거의 닫힐 때까지 닫아요. 강가의 종이 한 칸에 내려요. 바로 거기까지 가까운 돌의 그림자가 닿아요. 올라선 뒤 책을 펼치면 접는 선 가까이로 돌아와요."
          }
        }
      }
    },
    "twoShades.line": {
      "comment": "Level \"twoShades\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一道影子送你出去，另一道接你回来。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One shadow carries you out; the other brings you back."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一つの影が運び出し、もう一つが連れ帰る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 그림자가 데려가고, 다른 그림자가 데려온다."
          }
        }
      }
    },
    "twoShades.name": {
      "comment": "Level \"twoShades\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两道影"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two Shades"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "二つの影"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 그림자"
          }
        }
      }
    }
  },
  "version": "1.0"
}
