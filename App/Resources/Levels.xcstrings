    "lend.hint": {
      "comment": "Level \"lend\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先合上一次，胶把这边的石头粘到对岸去。打开，再斜起到 30°–50°：它的影子落在缺口上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close once, and the glue carries this stone to the far page. Open, then lean to 30°–50°: its shadow falls on the gap."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず一度閉じて、糊でこちらの石を向こう岸へ送る。開いて、30°〜50°まで傾ける。その影がすき間に落ちる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 한 번 닫아요. 풀이 이쪽 돌을 건너편으로 보내요. 펼치고 30°~50°로 기울여요. 그 그림자가 틈 위에 떨어져요."
          }
        }
      }
    },
    "lend.line": {
      "comment": "Level \"lend\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对岸没有石头，就没有影子。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No stone on the far page, so no shadow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "向こうの頁に石がなければ、影もない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건너편 페이지에 돌이 없으면 그림자도 없다."
          }
        }
      }
    },
    "lend.name": {
      "comment": "Level \"lend\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "借石"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrowed Stone"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "借りた石"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빌린 돌"
          }
        }
      }
    },
    "lift.hint": {
      "comment": "Level \"lift\": hint. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "斜到 50°，左页石头的影子落在你下面一行的缺口上，踩上去；开到 70°，影子滑回铰链边，把你放在一格纸的上面。合上，叠合走到她。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lean to 50°: the left stone’s shadow lies on the gap below you; step on. Open to 70° and it slides back towards the hinge, setting you above a square of paper. Close, and the stacks lead to her."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じると綴じ目から遠ざかる。影に乗って外へ、石の束に着く前に降りる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫으면 경첩에서 멀어져요. 그림자를 타고 바깥으로, 돌의 묶음에 닿기 전에 내려요."
          }
        }
      }
    },
    "lift.hint1": {
      "comment": "Level \"lift\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合书影子往外滑，开书它回来。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing slides a shadow outward; opening brings it back."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "向きが逆。影は外へ滑り、端で落ちる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방향이 반대예요. 그림자는 바깥으로 미끄러지고 끝에서 떨어져요."
          }
        }
      }
    },
    "lift.line": {
      "comment": "Level \"lift\": one-line teaser. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "举起来的那页也有影子。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lifted page has shadows too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "持ち上げた頁にも影がある。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "들어 올린 면에도 그림자가 있어요."
          }
        }
      }
    },
    "lift.name": {
      "comment": "Level \"lift\": title. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "举"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "持ち上げ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "들어 올림"
          }
        }
      }
    },
    "lock.hint": {
      "comment": "Level \"lock\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿左页绕到第 4 列。先斜起到 80° 左右，只有远处石头的影子伸到第 4 列的缺口；走上去，再往上。然后合到 40° 左右，近处石头的影子落在第 3 列：走过去，到左上第 3 格，合上——这一叠直通信。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk round the left page to column 4. Lean to about 80°: only the far stone’s shadow reaches the gap in column 4; step on and go up. Then close to about 40°: the near stone’s shadow falls in column 3. Cross it to the top-left third square and close — the stack runs straight to the letter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "（TODO ja）左ページを回って4列目へ。80°ほどに傾けると遠い石の影だけが届く。乗って上へ。40°ほどまで閉じると近い石の影が3列目に。渡って左上の3枡目で閉じる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "(TODO ko) 왼쪽 페이지를 돌아 4열로. 80° 정도 기울이면 먼 돌의 그림자만 닿아요. 올라서 위로. 40° 정도까지 닫으면 가까운 돌의 그림자가 3열에. 건너 왼쪽 위 셋째 칸에서 닫아요."
          }
        }
      }
    },
    "lock.hint1": {
      "comment": "Level \"lock\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两道影子，各在哪个角度？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two shadows — at which angle each?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "二つの影、それぞれどの角度？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 그림자, 각각 어느 각도?"
          }
        }
      }
    },
    "lock.line": {
      "comment": "Level \"lock\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远的影子跑得快。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The far shadow moves faster."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遠い影は速い。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼 그림자가 빠르다."
          }
        }
      }
    },
    "lock.name": {
      "comment": "Level \"lock\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远近"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Near and Far"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遠近"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "멀고 가까운"
          }
        }
      }
    },
    "oldHome.hint": {
      "comment": "Level \"oldHome\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有石头就没有影子——先合上，让两块石头都过去。站在右页最下面那格纸上合（站在胶上会被压）。合着走到左页下角那格纸，打开到 70°：新石头的影子落在第 4 列。踩上去，慢慢合到 50°，影子带你到第 2 列；石头原来站的地方现在是纸，走过去就到了。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No stone, no shadow. Close first and let both stones cross. Close from the lowest paper on the right page (the glue would crush you). Closed, walk to the bottom paper of the left page, then open to 70°: the new stone’s shadow falls in column 4. Step on, close slowly to 50°: it carries you to column 2. Where the stone used to stand is paper now. Walk home."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "石がなければ影もない。まず閉じて、二つの石を向こうへ送る。右頁いちばん下の紙の上で閉じる（糊の上では押しつぶされる）。閉じたまま左頁の下の紙へ歩き、70°まで開く。新しい石の影が4列目に落ちる。乗って、ゆっくり50°まで閉じる。影が2列目まで運ぶ。石がいた場所は今は紙。歩いて帰る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "돌이 없으면 그림자도 없어요. 먼저 닫아서 돌 두 개를 건너 보내요. 오른쪽 페이지 맨 아래 종이에서 닫아요(풀 위에서는 눌려요). 닫은 채 왼쪽 페이지 아래 종이로 걸어가 70°로 펼쳐요. 새 돌의 그림자가 4열에 떨어져요. 올라서서 천천히 50°까지 닫으면 2열로 데려가요. 돌이 있던 자리는 이제 종이예요. 걸어서 돌아가요."
          }
        }
      }
    },
    "oldHome.hint1": {
      "comment": "Level \"oldHome\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "胶把石头粘走以后，它原来那一格就成了纸。信的旁边，哪一格原来是石头？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the glue pulls a stone away, the square it stood on turns to paper. Which square next to the letter was a stone?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "糊が石を引き取ると、石のいた枡は紙になる。手紙のとなりで、石だったのはどの枡？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "풀이 돌을 가져가면 돌이 있던 칸은 종이가 돼요. 편지 옆에서 원래 돌이었던 칸은 어디일까요?"
          }
        }
      }
    },
    "oldHome.line": {
      "comment": "Level \"oldHome\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对岸一块石头也没有。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not one stone on the far page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "向こうの頁に石はひとつもない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건너편 페이지에 돌이 하나도 없다."
          }
        }
      }
    },
    "oldHome.name": {
      "comment": "Level \"oldHome\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧处"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Old Home"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の場所"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "옛 자리"
          }
        }
      }
    },
    "oneClose.hint": {
      "comment": "Level \"oneClose\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站在胶上合，石头落在你头上；站在胶上面合，石头落在路上，你回不去了。先走到胶的下面，再合上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close on the glue and the stone lands on you; close above it and the stone lands on your road, and you cannot get back. Walk below the glue first, then close."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "糊の上で閉じれば石が頭に落ちる。糊の上側で閉じれば石が道に落ち、戻れなくなる。まず糊の下まで歩いて、閉じる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "풀 위에서 닫으면 돌이 머리 위로 떨어져요. 풀 위쪽에서 닫으면 돌이 길에 떨어져 돌아갈 수 없어요. 먼저 풀 아래까지 걸어가서 닫아요."
          }
        }
      }
    },
    "oneClose.line": {
      "comment": "Level \"oneClose\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只合一次。在哪里合？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close only once. But where?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じるのは一度。でも、どこで？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번만 닫아요. 그런데 어디서?"
          }
        }
      }
    },
    "oneClose.name": {
      "comment": "Level \"oneClose\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一合"
