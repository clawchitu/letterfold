    "press.hint": {
      "comment": "Level \"press\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "别在起点合上——对面的石头会压下来。沿左页往上走到顶，斜起到 30° 左右：远处石头的影子落在第 1 列。走过影子到左上角，在那里合上，合着一路往下就是信。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not close at the start — the stone opposite comes down. Walk up the left page to the top and lean to about 30°: the far stone’s shadow falls in column 1. Cross it to the top-left corner and close there; closed, walk straight down to the letter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "（TODO ja）出発点で閉じないこと。向かいの石が落ちる。左ページを上まで歩き、30°ほどに傾ける。遠い石の影が1列目に落ちる。影を渡って左上の角へ、そこで閉じ、閉じたまままっすぐ下へ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "(TODO ko) 시작점에서 닫지 마세요. 맞은편 돌이 떨어져요. 왼쪽 페이지를 끝까지 올라가 30° 정도 기울여요. 먼 돌의 그림자가 1열에 떨어져요. 그림자를 건너 왼쪽 위 모서리에서 닫고, 닫은 채 곧장 내려가요."
          }
        }
      }
    },
    "press.hint1": {
      "comment": "Level \"press\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "哪一格合上是安全的？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which square is safe to close from?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの枡なら閉じても安全？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 칸에서 닫으면 안전할까?"
          }
        }
      }
    },
    "press.line": {
      "comment": "Level \"press\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "头顶有石头，对岸也有。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A stone over your head; another over the far bank."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頭の上に石。向こう岸にも。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "머리 위에 돌, 건너편에도."
          }
        }
      }
    },
    "press.name": {
      "comment": "Level \"press\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压"
          }
        },
        "en": {
