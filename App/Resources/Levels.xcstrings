    "pressedFlower.hint": {
      "comment": "Level \"pressedFlower\": hint. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先合上的话，胶把石头粘过来，路就断了。从起点走到左下角，斜起到 40° 踩上影子，再打开到 60°：影子带你到第 2 列。走到第 4 列第 2 行，合上、翻过来，合着往下走到底。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close first and the glue pulls a stone across: the road breaks. From the start walk to the bottom-left, lean to 40° onto the shadow, then open to 60°: it carries you to column 2. Walk to column 4, row 2, close, turn, and walk the stack to the bottom."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に閉じると糊が石を引き寄せ、道が切れる。はじめの位置から左下の角へ歩き、40°まで傾けて影に乗り、60°まで開く。影がきみを2列目へ運ぶ。4列目2行目まで歩いて、閉じて裏返し、閉じたまま下まで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 닫으면 풀이 돌을 끌어와 길이 끊겨요. 출발점에서 왼쪽 아래 모서리까지 가서 40°로 기울여 그림자에 올라선 뒤 60°까지 펼쳐요. 그림자가 당신을 2열로 옮겨요. 4열 2행까지 걸어가 닫고 뒤집은 뒤, 닫은 채 맨 아래까지."
          }
        }
      }
    },
    "pressedFlower.hint1": {
      "comment": "Level \"pressedFlower\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合上之前，先把影子走完。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish the shadow before you close."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる前に、影を歩ききる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫기 전에 그림자를 끝까지 걸어요."
          }
        }
      }
    },
    "pressedFlower.line": {
      "comment": "Level \"pressedFlower\": one-line teaser. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
