    "overleaf.hint": {
      "comment": "Level \"overleaf\": hint. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合上。合着走的时候，两页都是纸你就留在原来那页；只有一页是纸的那一叠才换页。走到右页是缺口的那一叠，你就到了左页——在那里翻。然后合着一直走到底，她在第三页的角上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close. Walking closed, where both pages are paper you stay on your page; only a stack with paper on one side changes your page. Walk into the stack whose right-page cell is a gap: you land on the left page — turn there. Then walk the stack to the bottom; she is in the corner of the third page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる。閉じたまま歩くとき、両方の頁が紙ならいまの頁にとどまり、片方だけが紙の重なりでだけ頁を移る。右頁がすき間の重なりへ歩けば左頁に移る——そこでめくる。それから閉じたまま下まで歩く。彼女は三枚目の頁の角にいる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫아요. 닫은 채 걸을 때 두 페이지가 모두 종이면 지금 페이지에 머물고, 한쪽만 종이인 겹에서만 페이지를 옮겨요. 오른쪽 페이지가 틈인 겹으로 가면 왼쪽 페이지에 닿아요. 거기서 넘겨요. 그다음 닫은 채 맨 아래까지 걸어요. 그녀는 세 번째 페이지 모서리에 있어요."
          }
        }
      }
    },
    "overleaf.hint1": {
      "comment": "Level \"overleaf\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翻之前，先到左页。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get onto the left page before you turn."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "めくる前に、左頁へ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "넘기기 전에 먼저 왼쪽 페이지로."
          }
        }
      }
    },
    "overleaf.line": {
      "comment": "Level \"overleaf\": one-line teaser. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你站着的那一页，翻不动。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The page under your feet will not turn."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "立っている頁は、めくれない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서 있는 페이지는 넘어가지 않는다."
          }
        }
      }
    },
    "overleaf.name": {
      "comment": "Level \"overleaf\": title. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
