    "inkShore.hint": {
      "comment": "Level \"inkShore\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿右页绕到右上，合上：墨印到左页，这一叠下面是石头。合着往左到左页，打开到 40°：踩上第 2 列的影子。再开到 55°，影子带你到第 3 列；穿过印着的墨，踩上下面那道影子，走到左下的纸上，合上——信在对面。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk round the right page to its upper right and close: the ink prints onto the left page, and this stack sits on a stone. Closed, go left onto the left page and open to 40°: step onto the shadow in column 2. Open to 55°: it carries you to column 3. Cross the printed ink onto the lower shadow, walk to the paper at the bottom-left, and close — the letter is opposite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右ページを回って右上で閉じる：墨が左ページに写り、この重なりの下は石。閉じたまま左ページへ渡り、40°まで開く：2列目の影に乗る。55°まで開く：影があなたを3列目へ運ぶ。写った墨を越えて下の影へ、左下の紙まで歩いて閉じる——手紙は向かい。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 페이지를 돌아 오른쪽 위에서 닫아요: 먹이 왼쪽 페이지에 찍히고, 이 겹 아래는 돌이에요. 닫은 채 왼쪽 페이지로 건너가 40°까지 펼쳐요: 2열 그림자에 올라서요. 55°까지 펼쳐요: 그림자가 나를 3열로 데려가요. 찍힌 먹을 지나 아래 그림자로, 왼쪽 아래 종이까지 걸어가 닫아요—편지는 맞은편에."
          }
        }
      }
    },
    "inkShore.hint1": {
      "comment": "Level \"inkShore\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先印岸，再走影子。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Print the shore first, then walk the shadows."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず岸を写し、それから影を歩く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 강가를 찍고, 그다음 그림자를 걸어요."
          }
        }
      }
    },
    "inkShore.line": {
      "comment": "Level \"inkShore\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两道影子之间，一格墨。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Between two shadows, one square of ink."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "二つの影のあいだに、墨が一マス。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 그림자 사이에, 먹 한 칸."
          }
        }
      }
    },
    "inkShore.name": {
      "comment": "Level \"inkShore\": title. From fold-proto i18n.js.",
