    "twiceClosed.hint": {
      "comment": "Level \"twiceClosed\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先合上一次：胶把石头粘到右页顶上。合着走到左页第 3 行，打开到 30°：影子落在第 2 列。从石头的旧位走上去，打开到 55°，影子带你到第 3 列；往下走，下页石头的影子接到最后一格纸。只有那一格合上是安全的——在那里合，终点就在脚下。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close once: the glue pulls the stone to the top of the right page. Closed, walk to row 3 of the left page and open to 30°: the shadow is in column 2. Step on from the stone’s old place, open to 55°, and it carries you to column 3; walk down, the lower stone’s shadow reaches the last paper. Only that cell is safe to close from. Close there: the letter is under your feet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず一度閉じる：糊が石を右ページのいちばん上へ引き寄せる。閉じたまま左ページの3行目へ歩き、30°まで開く：影が2列目に落ちる。石の元の場所から乗って55°まで開くと、影があなたを3列目へ運ぶ。下へ歩くと、下の石の影が最後の紙まで届く。閉じて安全なのは、そのマスだけ。そこで閉じれば、手紙は足もとに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 한 번 닫아요: 풀이 돌을 오른쪽 페이지 맨 위로 끌어가요. 닫은 채 왼쪽 페이지 3행으로 걸어가 30°까지 펼쳐요: 그림자가 2열에 떨어져요. 돌의 옛 자리에서 올라서서 55°까지 펼치면 그림자가 나를 3열로 데려가요. 아래로 걸으면 아래 돌의 그림자가 마지막 종이까지 닿아요. 닫아도 안전한 칸은 거기뿐. 거기서 닫으면, 편지는 발밑에."
          }
        }
      }
    },
    "twiceClosed.hint1": {
      "comment": "Level \"twiceClosed\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第二次合上，站在哪？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The second close: from where?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "二度目は、どこで閉じる？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 번째는, 어디서 닫을까?"
          }
        }
