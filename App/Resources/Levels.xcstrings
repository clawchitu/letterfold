    "return.name": {
      "comment": "Level \"return\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "戻る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "돌아옴"
          }
        }
      }
    },
    "ride.hint": {
      "comment": "Level \"ride\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿左边走到第 3 行左端。合到 30° 左右，影子伸到脚边；站上去，再把书打开到 70°：影子带着你滑到第 4 列。走到左上角那格纸，合上，合着绕一圈到信。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk the left edge to the left end of row 3. Close to about 30°: the shadow reaches your feet. Step on, then OPEN the book to 70°: the shadow carries you to column 4. Walk to the top-left paper, close, and walk the stack round to the letter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左端を3行目の左端まで歩く。30°ほどまで閉じる：影が足もとに届く。乗って、こんどは本を70°まで開く：影があなたを4列目まで運ぶ。左上の紙まで歩いて閉じ、重なりを回って手紙へ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼쪽 가장자리를 따라 3행 왼쪽 끝까지 걸어가요. 30°쯤까지 닫아요: 그림자가 발밑에 닿아요. 올라서서, 이번엔 책을 70°까지 펼쳐요: 그림자가 나를 4열까지 데려가요. 왼쪽 위 종이까지 걸어가 닫고, 겹을 돌아 편지로."
          }
        }
      }
    },
    "ride.hint1": {
      "comment": "Level \"ride\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站在影子上，再动书。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand on the shadow, then move the book."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "影の上に立って、それから本を動かす。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림자 위에 선 다음, 책을 움직여요."
          }
        }
      }
    },
    "ride.line": {
      "comment": "Level \"ride\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺口太宽，影子太短。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The gap too wide, the shadow too short."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すき間は広く、影は短い。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "틈은 넓고, 그림자는 짧다."
          }
        }
      }
    },
    "ride.name": {
      "comment": "Level \"ride\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "乘影"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shadow Ride"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "影に乗る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림자 타기"
          }
        }
      }
    },
    "rideBack.hint": {
      "comment": "Level \"rideBack\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿左边走到左下角。合到 50° 左右，踩上影子，再打开到 80°：影子带你到第 4 列，旁边那格纸是唯一的岸。下去，在岸上合上，合着往右走就是信。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk the left edge to the bottom-left corner. Close to about 50°, step onto the shadow, then open to 80°: it carries you to column 4, beside the only square of shore. Step down, close on the shore, and walk the stack right to the letter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左端を左下の角まで歩く。50°ほどまで閉じて影に乗り、80°まで開く：影があなたを4列目へ運ぶ。となりの紙が、たった一つの岸。降りて、岸で閉じ、閉じたまま右へ歩けば手紙。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼쪽 가장자리를 따라 왼쪽 아래 모서리까지. 50°쯤까지 닫아 그림자에 올라서고, 80°까지 펼쳐요: 그림자가 나를 4열로 데려가요. 옆의 종이가 하나뿐인 강가. 내려서서 강가에서 닫고, 닫은 채 오른쪽으로 걸으면 편지."
          }
        }
      }
    },
    "rideBack.hint1": {
      "comment": "Level \"rideBack\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "那格纸，怎么才到得了？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That square of paper: how do you reach it?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その一マスの紙へ、どうやって？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 한 칸 종이에, 어떻게 가지?"
          }
        }
      }
    },
    "rideBack.line": {
      "comment": "Level \"rideBack\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
