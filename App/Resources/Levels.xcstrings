          }
        }
      }
    },
    "stand.hint": {
      "comment": "Level \"stand\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把手机打开到一半，折痕上的纸片会立起来，连成一座桥。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the phone halfway: the tabs on the crease stand up and join into a bridge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマホを半分だけ開くと、折り目の紙片が立ち上がり、橋になる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폰을 반쯤 열면 접는 선의 종이 조각이 일어서서 다리가 돼요."
          }
        }
      }
    },
