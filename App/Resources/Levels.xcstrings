          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The blot on the far page grows too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "向こうの墨も育つ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건너편 먹도 자라요."
          }
        }
      }
    },
    "print.line": {
      "comment": "Level \"print\": one-line teaser. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
