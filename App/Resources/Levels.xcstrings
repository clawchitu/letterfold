    "twoBridges.hint": {
      "comment": "Level \"twoBridges\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立起来：两座桥都在。走过上面那座，沿着立起的页走到底，从下面那座回来。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open halfway: both bridges stand. Cross the top one, walk down the standing page, come back over the bottom one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "半分だけ開くと、橋が二つ立つ。上の橋を渡り、立ったページを端まで歩いて、下の橋で戻る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반쯤 열면 다리 두 개가 서요. 위 다리를 건너 선 페이지를 끝까지 걷고, 아래 다리로 돌아와요."
          }
        }
      }
    },
    "twoBridges.line": {
      "comment": "Level \"twoBridges\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过去，再回来。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over, and back."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "渡って、戻る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건너갔다가, 돌아온다."
          }
        }
      }
    },
    "twoBridges.name": {
