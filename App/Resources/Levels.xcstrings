    },
    "twoLamps.line": {
      "comment": "Level \"twoLamps\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页角粘着，墨还没干。"
