    "darkDoor.name": {
      "comment": "Level \"darkDoor\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "门"
          }
        },
