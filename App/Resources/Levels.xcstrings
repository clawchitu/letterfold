          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The glue faces the loose stone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "糊は、転がる石に向いている。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
