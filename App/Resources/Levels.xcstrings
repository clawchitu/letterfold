    "inkTwice.hint": {
      "comment": "Level \"inkTwice\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "走到桥头的纸片上合上：墨印到右页。半开过桥，踩上印过去的墨，绕右页一圈走到右下方，再合上——这一叠下面是石头。合着往左一格就是信。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close on the tab at the foot of the start: the ink prints across. Half-open, cross, step onto the printed ink and loop round the right page to its lower right, then close again — this stack sits on a stone. Closed, one step left is the letter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出発点の下の紙片で閉じる：墨が右ページに写る。半開きで渡り、写った墨に乗って、右ページをぐるりと回って右下へ、また閉じる——この重なりの下は石。閉じたまま左へ一歩が手紙。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출발점 아래 종이 조각에서 닫아요: 먹이 오른쪽 페이지에 찍혀요. 반쯤 열어 건너고, 찍힌 먹에 올라서서 오른쪽 페이지를 빙 돌아 오른쪽 아래로, 다시 닫아요—이 겹 아래는 돌이에요. 닫은 채 왼쪽으로 한 칸이 편지."
          }
        }
      }
    },
    "inkTwice.hint1": {
      "comment": "Level \"inkTwice\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "印过去的墨在哪？从它开始。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where did the ink print? Start there."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "墨はどこに写った？ そこから始める。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먹은 어디에 찍혔지? 거기서 시작해요."
          }
        }
      }
    },
    "inkTwice.line": {
      "comment": "Level \"inkTwice\": one-line teaser. From fold-proto i18n.js.",
