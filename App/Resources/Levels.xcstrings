    "ferry.hint": {
      "comment": "Level \"ferry\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先合上：胶把石头粘到右页。合着走到左页左下角，打开到 50°：新石头的影子落在第 3 列。从石头原来的位置走上影子，再把书打开到 70°——影子带你到第 4 列，而 70° 时纸片桥正立着。顺着影子往下，过桥，终点在桥头。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close first: the glue pulls the stone to the right page. Closed, walk to the bottom-left of the left page, then open to 50°: the new shadow falls in column 3. Walk from the stone’s old place onto it, then open FURTHER to 70°: the shadow carries you to column 4, and at 70° the tabs stand. Down the shadow, over the bridge; the letter is at its foot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず閉じる。糊が石を右頁へ引く。閉じたまま左頁の左下へ歩き、50°まで開く。新しい影が3列目に落ちる。石の元の場所から影に乗り、さらに70°まで開く。影は4列目へ運び、70°では紙片の橋が立っている。影を下り、橋を渡る。手紙は橋のたもとに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 닫아요. 풀이 돌을 오른쪽 페이지로 붙여요. 닫은 채 왼쪽 페이지 왼쪽 아래로 걸어가 50°로 펼쳐요. 새 그림자가 3열에 떨어져요. 돌의 옛 자리에서 그림자에 올라, 더 펼쳐 70°로. 그림자가 4열로 데려가고, 70°에서는 종이 조각 다리가 서 있어요. 그림자를 따라 내려가 다리를 건너요. 편지는 다리 밑에."
          }
        }
      }
    },
    "ferry.hint1": {
      "comment": "Level \"ferry\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开一点，而不是合上一点。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a little, not close a little."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少し閉じるのではなく、少し開く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조금 닫지 말고, 조금 펼쳐요."
          }
        }
      }
    },
    "ferry.line": {
      "comment": "Level \"ferry\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "河不宽，路很长。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The river is narrow; the road is long."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "川は狭く、道は長い。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강은 좁고 길은 길다."
          }
        }
      }
    },
    "ferry.name": {
      "comment": "Level \"ferry\": title. From fold-proto i18n.js.",
