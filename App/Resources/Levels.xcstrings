    "twice.hint": {
      "comment": "Level \"twice\": hint. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "斜起（它滚一格），再放平（再滚一格）：石头掉进缺口，桥就有了。合上再打开，也是这两次。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lean (it rolls one), flatten (it rolls one more): the stone drops into the gap and the bridge is there. Close and open again would have been the same two passes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "傾けて（一枡）、平らに戻す（もう一枡）：石が隙間に落ちて橋になる。閉じて開いても同じ二度。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기울이고(한 칸), 다시 펴요(한 칸 더): 돌이 틈에 떨어져 다리가 돼요. 닫았다 열어도 같은 두 번이에요."
          }
        }
      }
    },
    "twice.hint1": {
      "comment": "Level \"twice\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来回一次是两次过立；放平那一下也算。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A lean that comes back is two passes; flattening counts too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "往復は二度の「立ち」。戻すほうも数える。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 오가는 건 두 번 세우는 것. 펴는 쪽도 세요."
          }
        }
      }
    },
    "twice.line": {
