        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The gap too wide, the shadow too short."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すき間は広く、影は短い。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "틈은 넓고, 그림자는 짧다."
          }
