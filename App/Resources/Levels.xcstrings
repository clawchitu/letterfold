            "value": "この頁に手紙はない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 페이지에는 편지가 없다."
          }
        }
      }
    },
    "turn.name": {
      "comment": "Level \"turn\": title. From fold-proto i18n.js. ja/ko: TODO-native-check.",
