    "rideBack.name": {
      "comment": "Level \"rideBack\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回程"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Way Back"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "帰り道"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "돌아오는 길"
          }
        }
      }
    },
    "rideFirst.hint": {
      "comment": "Level \"rideFirst\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合上时胶会把石头粘到这边来，影子就没了。所以先斜起到 60°，踩上影子，再慢慢合到 45°：影子带你过去。下到纸上，再合上——钥匙开门。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing lets the glue pull the stone to this page, and the shadow goes with it. So lean to 60° first, step on the shadow, and close slowly to 45°: it carries you across. Step down onto the paper, then close: the key opens the door."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じれば糊が石をこちらへ引き寄せて、影も消える。だからまず60°まで傾けて影に乗り、ゆっくり45°まで閉じる：影があなたを向こうへ運ぶ。紙に降りて、閉じる：鍵が扉を開ける。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫으면 풀이 돌을 이쪽으로 끌어오고, 그림자도 사라져요. 그러니 먼저 60°로 기울여 그림자에 올라서고, 천천히 45°까지 닫아요: 그림자가 나를 건너편으로 데려가요. 종이에 내려서서 닫아요: 열쇠가 문을 열어요."
          }
        }
      }
    },
    "rideFirst.line": {
      "comment": "Level \"rideFirst\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "影子会走，石头也会。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shadows move. So do stones."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "影は動く。石も動く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림자는 움직인다. 돌도 움직인다."
          }
        }
      }
    },
    "rideFirst.name": {
      "comment": "Level \"rideFirst\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先乘影"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ride First"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に乗る"
          }
        },
        "ko": {
          "stringUnit": {
