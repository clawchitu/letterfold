    "inlay.hint": {
      "comment": "Level \"inlay\": hint. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "走到左页第 3 行的左端，斜起到 40°：两块石头的影子一起铺到顶行。走到右上角那格纸，合上、翻过来，合着往下走两格。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk to the left end of row 3 on the left page, lean to 40°: both shadows pave the top row at once. Walk to the top-right paper, close, turn, and walk the stack two steps down."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左頁3行目の左端まで歩き、40°まで傾ける。二つの石の影が一緒にいちばん上の行を敷く。右上の紙まで歩いて、閉じて裏返し、閉じたまま下へ二枡。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼쪽 페이지 3행 왼쪽 끝까지 가서 40°로 기울여요. 두 돌의 그림자가 함께 맨 윗줄을 깔아요. 오른쪽 위 종이까지 걸어가 닫고 뒤집은 뒤, 닫은 채 아래로 두 칸."
          }
        }
      }
    },
    "inlay.hint1": {
      "comment": "Level \"inlay\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "顶行是走过去的，不是合过去的。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The top row is walked to, not closed to."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いちばん上の行は、閉じてではなく歩いて行く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "맨 윗줄은 닫아서가 아니라 걸어서 간다."
          }
        }
      }
    },
    "inlay.line": {
      "comment": "Level \"inlay\": one-line teaser. From fold-proto i18n.js. ja/ko: TODO-native-check.",
