          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where the crane lands is paper."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鶴が降りたところは紙。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "학이 내려앉은 곳은 종이예요."
          }
        }
      }
    },
    "land.line": {
      "comment": "Level \"land\": one-line teaser. From fold-proto i18n.js. ja/ko: TODO-native-check.",
