    "lend.hint": {
      "comment": "Level \"lend\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先合上一次，胶把这边的石头粘到对岸去。打开，再斜起到 30°–50°：它的影子落在缺口上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close once, and the glue carries this stone to the far page. Open, then lean to 30°–50°: its shadow falls on the gap."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず一度閉じて、糊でこちらの石を向こうのページへ送る。開いて、30°〜50°に傾ける：その石の影がすき間に落ちる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 한 번 닫아요: 풀이 이쪽 돌을 건너편 페이지로 데려가요. 펼치고, 30°~50°로 기울여요: 그 돌의 그림자가 틈 위에 떨어져요."
          }
        }
      }
    },
    "lend.line": {
      "comment": "Level \"lend\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对岸没有石头，就没有影子。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No stone on the far page, so no shadow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "向こうのページに石がなければ、影もない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건너편 페이지에 돌이 없으면, 그림자도 없다."
          }
        }
      }
    },
    "lend.name": {
      "comment": "Level \"lend\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "借石"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrowed Stone"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "借りた石"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빌린 돌"
          }
        }
      }
    },
    "lift.hint": {
      "comment": "Level \"lift\": hint. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "斜到 50°，左页石头的影子落在你下面一行的缺口上，踩上去；开到 70°，影子滑回铰链边，把你放在一格纸的上面。合上，叠合走到她。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lean to 50°: the left stone’s shadow lies on the gap below you; step on. Open to 70° and it slides back towards the hinge, setting you above a square of paper. Close, and the stacks lead to her."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "50°に傾ける：左ページの石の影が、あなたの下の行のすき間に落ちる。乗る。70°まで開くと影は綴じ目のほうへ滑り戻り、あなたを一マスの紙の上に降ろす。閉じれば、重なりが彼女へ続く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "50°로 기울여요: 왼쪽 페이지 돌의 그림자가 내 아랫줄 틈에 놓여요. 올라서요. 70°까지 펼치면 그림자가 접는 선 쪽으로 미끄러져 돌아와, 나를 종이 한 칸 위에 내려놓아요. 닫으면, 겹이 그녀에게 이어져요."
          }
        }
      }
    },
    "lift.hint1": {
      "comment": "Level \"lift\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合书影子往外滑，开书它回来。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing slides a shadow outward; opening brings it back."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じると影は外へ滑り、開くと戻ってくる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫으면 그림자가 바깥으로 미끄러지고, 펼치면 돌아와요."
          }
        }
      }
    },
    "lift.line": {
      "comment": "Level \"lift\": one-line teaser. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "举起来的那页也有影子。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lifted page has shadows too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "持ち上げたページにも、影がある。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "들어 올린 페이지에도 그림자가 있다."
          }
        }
      }
    },
    "lift.name": {
      "comment": "Level \"lift\": title. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "举"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "持ち上げ"
          }
        },
        "ko": {
