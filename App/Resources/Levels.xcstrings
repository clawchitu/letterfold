    "land.hint": {
      "comment": "Level \"land\": hint. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你站在左页，鹤在右页——合上书：它飞到你这页的镜像格，正好落在缺口里。打开，缺口是纸了，走过去。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are on the left page, the crane on the right — close the book: it flies to the mirror square on your page, right into the gap. Open: the gap is paper now. Walk across."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは左ページ、鶴は右ページ——本を閉じる：鶴はこちらのページの鏡のマス、ちょうどすき間へ降りる。開けば、すき間は紙。渡る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나는 왼쪽 페이지, 학은 오른쪽 페이지—책을 닫아요: 학이 이쪽 페이지의 거울 칸, 바로 그 틈에 내려앉아요. 펼치면, 틈은 종이. 건너가요."
          }
        }
      }
    },
    "land.hint1": {
      "comment": "Level \"land\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鹤落在哪，哪就是纸。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where the crane lands is paper."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鶴が降りたところは、紙。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "학이 내려앉은 곳은, 종이."
          }
        }
      }
    },
    "land.line": {
      "comment": "Level \"land\": one-line teaser. From fold-proto i18n.js. ja/ko: TODO-native-check.",
