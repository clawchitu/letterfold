    "twoFaces.hint": {
      "comment": "Level \"twoFaces\": hint. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿左页走到左下角，斜起到 60°：石头的影子接到第 4 列。顺着影子走到第 3 行，合上、翻过来，合着往上走到顶——信在第三页的顶行。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk the left page to its bottom-left, lean to 60°: the stone’s shadow reaches column 4. Follow the shadow up to row 3, close, turn, and walk the stack to the top — the letter is in the third page’s top row."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左ページを左下まで歩き、60°に傾ける：石の影が4列目まで届く。影をたどって3行目へ上がり、閉じて、めくって、閉じたまま上まで歩く——手紙は三枚目のページのいちばん上の行。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼쪽 페이지를 왼쪽 아래까지 걸어가 60°로 기울여요: 돌의 그림자가 4열까지 닿아요. 그림자를 따라 3행으로 올라가, 닫고, 넘기고, 닫은 채 맨 위까지 걸어요—편지는 셋째 페이지 맨 윗줄에."
          }
        }
      }
    },
    "twoFaces.hint1": {
      "comment": "Level \"twoFaces\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先用这一面的影子，再翻。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this face’s shadow first, then turn."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずこの面の影を使って、それからめくる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 이 면의 그림자를 쓰고, 그다음 넘겨요."
          }
        }
      }
    },
    "twoFaces.line": {
      "comment": "Level \"twoFaces\": one-line teaser. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灯照着的是这一面。"
          }
        },
        "en": {
