        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "……まだ渡らないで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "……아직 건너지 마."
          }
        }
