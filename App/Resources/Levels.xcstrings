    "turn.hint": {
      "comment": "Level \"turn\": hint. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合上，翻过来，再合着往下走：第 5 行左页是缺口、第三页是纸，走到那一叠你就换到了第三页——信在那里。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close, turn the book over, and walk the stack down: in row 5 the left page is a gap and the third page is paper, so that stack puts you onto the third page — the letter is there."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じて、めくって、閉じたまま下へ歩く：5行目は左ページがすき間で、三枚目のページが紙。その重なりへ歩けば、三枚目のページに移る——手紙はそこに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫고, 넘기고, 닫은 채 아래로 걸어요: 5행은 왼쪽 페이지가 틈이고 셋째 페이지가 종이예요. 그 겹으로 걸어가면 셋째 페이지로 옮겨 가요—편지는 거기에."
          }
        }
      }
    },
    "turn.hint1": {
      "comment": "Level \"turn\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合上的书，还能翻个面。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A closed book can be turned over."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じた本は、めくれる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫힌 책은, 넘길 수 있어요."
          }
        }
      }
    },
    "turn.line": {
      "comment": "Level \"turn\": one-line teaser. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
