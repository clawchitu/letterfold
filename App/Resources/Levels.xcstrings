        }
      }
    },
    "pressedFlower.line": {
      "comment": "Level \"pressedFlower\": one-line teaser. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
