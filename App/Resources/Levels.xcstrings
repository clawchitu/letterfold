    "darkDoor.hint": {
      "comment": "Level \"darkDoor\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "斜起到 60°，踩上右下石头的影子，然后一直合上——影子把你放在左页的纸上，书合拢，钥匙开门，胶把石头粘走。合着走到左页顶上（要换四次页）。打开到 50°，踩影子穿过开着的门，再合上，从门那一叠走到右页，打开，她就在旁边。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lean to 60°, step onto the lower-right stone’s shadow, then keep closing: the shadow sets you on paper as the book shuts; the key opens the door, the glue takes the stone. Closed, walk to the top of the left page (you change pages four times). Open to 50°, walk the shadow through the open door, close again, walk that stack onto the right page, open: she is beside you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "60°まで傾け、右下の石の影に乗り、そのまま閉じ続ける。本が閉じるとき影は紙の上に降ろし、鍵が扉を開け、糊が石を引き取る。閉じたまま左頁の上へ歩く（頁を四度またぐ）。50°まで開き、影で開いた扉を抜け、また閉じ、その重なりから右頁へ、開く。彼女は隣にいる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "60°로 기울여 오른쪽 아래 돌의 그림자에 오르고 계속 닫아요. 책이 닫히며 그림자가 종이에 내려 주고, 열쇠가 문을 열고, 풀이 돌을 가져가요. 닫은 채 왼쪽 페이지 맨 위로 걸어가요(페이지를 네 번 바꿔요). 50°로 펼쳐 그림자로 열린 문을 지나고, 다시 닫아 그 겹에서 오른쇽 페이지로, 펼쳐요. 그녀가 옆에 있어요."
          }
        }
      }
    },
    "darkDoor.hint1": {
      "comment": "Level \"darkDoor\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "乘着影子合上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ride the shadow into the close."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "影に乗ったまま閉じる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림자를 탄 채 닫아요."
          }
        }
      }
    },
    "darkDoor.line": {
      "comment": "Level \"darkDoor\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "……门后没有人。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "…nobody behind the door."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "……扉の向こうには誰もいない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "……문 뒤에는 아무도 없다."
          }
        }
      }
    },
    "darkDoor.name": {
      "comment": "Level \"darkDoor\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
