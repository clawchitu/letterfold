    "crease.hint": {
      "comment": "Level \"crease\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿第 4 列往下走到桥头，立起来过桥，往右一格，合上：钥匙开门、墨印过去，这一叠下面是石头。合着往上走到门那一格（第 2 行右侧），打开，往右一格到右页边上，再合上——这一叠下面又是一块石头，走一步就到信。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk down column 4 to the bridge, stand and cross, one step right, and close: the key opens the door, the ink prints across, and this stack sits on a stone. Closed, walk up to the door square (row 2, right side), open, one step right to the edge of the page, and close again — this stack sits on another stone, and one step is the letter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4列目を橋まで下り、立てて渡り、右へ一歩、閉じる：鍵が扉を開け、墨が写り、この重なりの下は石。閉じたまま扉のマス（2行目の右側）まで上がり、開いて、右へ一歩でページの端、また閉じる——この重なりの下にも石。一歩で手紙。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "4열을 따라 다리까지 내려가 세워서 건너고, 오른쪽으로 한 칸, 닫아요: 열쇠가 문을 열고, 먹이 찍히고, 이 겹 아래는 돌이에요. 닫은 채 문 칸(2행 오른쪽)까지 올라가, 펼치고, 오른쪽으로 한 칸 가면 페이지 가장자리, 다시 닫아요—이 겹 아래에도 돌. 한 걸음이면 편지."
          }
        }
      }
    },
    "crease.hint1": {
      "comment": "Level \"crease\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两次合，都站在石头的背上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both closes stand on the back of a stone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "二度の閉じ、どちらも石の背の上で。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 번 닫기, 둘 다 돌의 등 위에서."
          }
        }
      }
    },
    "crease.line": {
      "comment": "Level \"crease\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用上你学会的一切。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything you have learned."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "覚えたことを、ぜんぶ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배운 것을, 전부."
          }
        }
      }
    },
    "crease.name": {
      "comment": "Level \"crease\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
