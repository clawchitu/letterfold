    "ride.hint": {
      "comment": "Level \"ride\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿左边走到第 3 行左端。合到 30° 左右，影子伸到脚边；站上去，再把书打开到 70°：影子带着你滑到第 4 列。走到左上角那格纸，合上，合着绕一圈到信。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk the left edge to the left end of row 3. Close to about 30°: the shadow reaches your feet. Step on, then OPEN the book to 70°: the shadow carries you to column 4. Walk to the top-left paper, close, and walk the stack round to the letter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "（TODO ja）左端を3行目まで歩く。30°ほどまで閉じると影が足もとに。乗って、本を70°まで開く。影が4列目まで運ぶ。左上の紙へ歩いて閉じ、重なりを回って手紙へ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "(TODO ko) 왼쪽 끝을 따라 3행까지. 30° 정도까지 닫으면 그림자가 발밑에. 올라서서 책을 70°까지 펼쳐요. 그림자가 4열까지 데려가요. 왼쪽 위 종이로 걸어가 닫고, 겹을 돌아 편지로."
          }
        }
      }
    },
    "ride.hint1": {
      "comment": "Level \"ride\": first hint (the 「?」 ladder, before the hint). From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站在影子上，再动书。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand on the shadow, then move the book."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "影の上に立って、本を動かす。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림자 위에 서서, 책을 움직여요."
          }
        }
      }
    },
    "ride.line": {
      "comment": "Level \"ride\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺口太宽，影子太短。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The gap too wide, the shadow too short."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すき間は広く、影は短い。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "틈은 넓고, 그림자는 짧다."
          }
        }
      }
    },
    "ride.name": {
      "comment": "Level \"ride\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
