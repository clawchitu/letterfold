      "comment": "Level \"wet\": hint. From fold-proto i18n.js. ja/ko: TODO-native-check.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合上书：墨往四周洇一格，起点旁边的缺口变成了墨。打开，走过去。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the book: the ink bleeds one square outward, and the gap beside the start becomes ink. Open and walk across."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本を閉じる：墨が一マス外へ滲み、出発点のとなりのすき間が墨になる。開いて、歩いて渡る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "책을 닫아요: 먹이 한 칸 밖으로 번지고, 출발점 옆 틈이 먹이 돼요. 펼치고, 걸어서 건너요."
          }
        }
      }
