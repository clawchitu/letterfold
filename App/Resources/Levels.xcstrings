        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close once and watch it grow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度閉じて、広がるのを見て。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 닫고, 자라는 걸 봐요."
          }
        }
      }
    },
