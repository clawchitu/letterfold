    },
    "rightBank.line": {
      "comment": "Level \"rightBank\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两座桥，一扇没有钥匙的门。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two bridges, and a door with no key."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "橋が二つ、鍵のない扉が一つ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다리 둘, 열쇠 없는 문 하나."
          }
        }
      }
    },
    "rightBank.name": {
      "comment": "Level \"rightBank\": title. From fold-proto i18n.js.",
