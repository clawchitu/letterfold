            "state": "translated",
            "value": "Ink is quicker than glue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "墨は糊より速い。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먹이 풀보다 빨라요."
          }
        }
      }
    },
    "spoiled.line": {
      "comment": "Level \"spoiled\": one-line teaser. From fold-proto i18n.js. ja/ko: TODO-native-check.",
