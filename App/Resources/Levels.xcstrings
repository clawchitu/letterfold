    "glue.hint": {
      "comment": "Level \"glue\": hint. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合上一次：对面的胶会把石头粘过去。打开，路就空了。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close once: the glue opposite pulls the stone across. Open, and the road is clear."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度閉じる。向かいの糊が石を引き寄せる。開けば、道は空いている。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 닫아요. 맞은편 풀이 돌을 붙여 가요. 펼치면 길이 비어 있어요."
          }
        }
      }
    },
    "glue.line": {
      "comment": "Level \"glue\": one-line teaser. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "路上有石头，对岸有胶。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A stone on your road; glue on the far bank."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "道に石、向こう岸に糊。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길에 돌, 건너편에 풀."
          }
        }
      }
    },
    "glue.name": {
      "comment": "Level \"glue\": title. From fold-proto i18n.js.",
      "extractionState": "manual",
      "localizations": {
