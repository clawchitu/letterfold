          "stringUnit": {
            "state": "translated",
            "value": "门下影"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shade at the Door"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "扉の影"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
